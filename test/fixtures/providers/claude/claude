#!/bin/sh
set -eu

case "${1:-}" in
  --version|-v)
    if [ "${CREWFOLD_FIXTURE_CLAUDE_VERSION:-supported}" = "unsupported" ]
    then
      printf '3.0.0 (Claude Code)\n'
    else
      printf '2.1.220 (Claude Code)\n'
    fi
    exit 0
    ;;
  --help|-h)
    cat "$(dirname "$0")/help.txt"
    exit 0
    ;;
  auth)
    if [ "${2:-}" = "status" ] && [ "${3:-}" = "--json" ]
    then
      if [ "${CREWFOLD_FIXTURE_CLAUDE_AUTH:-authenticated}" = "missing" ]
      then
        printf '%s\n' '{"loggedIn":false}'
        exit 1
      fi
      printf '%s\n' '{"loggedIn":true,"authMethod":"fixture","apiProvider":"recorded"}'
      exit 0
    fi
    ;;
esac

print_mode=false
strict_mcp=false
no_persistence=false
stream_json=false
permission_mode=''
allowed_tools=''
mcp_config=''
prompt=''
while [ "$#" -gt 0 ]
do
  case "$1" in
    -p|--print)
      print_mode=true
      shift
      ;;
    --strict-mcp-config)
      strict_mcp=true
      shift
      ;;
    --no-session-persistence)
      no_persistence=true
      shift
      ;;
    --no-chrome|--disable-slash-commands|--verbose)
      shift
      ;;
    --output-format)
      stream_json=$([ "${2:-}" = "stream-json" ] && printf true || printf false)
      shift 2
      ;;
    --permission-mode)
      permission_mode=${2:-}
      shift 2
      ;;
    --allowedTools|--allowed-tools)
      allowed_tools=${2:-}
      shift 2
      ;;
    --mcp-config)
      mcp_config=${2:-}
      shift 2
      ;;
    --setting-sources|--settings|--tools|--max-budget-usd)
      shift 2
      ;;
    *)
      prompt=$1
      shift
      ;;
  esac
done

if [ "$print_mode" != true ] || [ "$strict_mcp" != true ] || [ "$no_persistence" != true ] || [ "$stream_json" != true ] || [ "$permission_mode" != dontAsk ]
then
  printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"recorded Claude launch contract is incomplete"}' >&2
  exit 1
fi
case "$allowed_tools" in
  *'Read(/**)'*'Edit(/**)'*mcp__crewfold__*) ;;
  *)
    printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Crewfold MCP tools are not allowed"}' >&2
    exit 1
    ;;
esac

bridge=$(printf '%s\n' "$mcp_config" | sed -n 's/.*"command":"\([^"]*\)".*/\1/p')
socket_path=$(printf '%s\n' "$mcp_config" | sed -n 's/.*"CREWFOLD_MCP_SOCKET":"\([^"]*\)".*/\1/p')
capability_file=$(printf '%s\n' "$mcp_config" | sed -n 's/.*"CREWFOLD_MCP_CAPABILITY_FILE":"\([^"]*\)".*/\1/p')
case "$mcp_config" in
  *'"args":["__mcp-stdio-bridge"]'*) ;;
  *) bridge='' ;;
esac
if [ -z "$bridge" ] || [ -z "$socket_path" ] || [ -z "$capability_file" ]
then
  printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"MCP server crewfold connection failed"}' >&2
  exit 1
fi

response_file=$(mktemp "${TMPDIR:-/tmp}/crewfold-claude-fixture.XXXXXX")
cleanup() {
  if [ -f "$response_file" ]
  then
    find "$response_file" -delete
  fi
}
trap cleanup EXIT HUP INT TERM

handoff_mode=false
case "$prompt" in
  *provider_handoff_received*) handoff_mode=true ;;
esac

evidence='["implementation_complete","tests_passed"]'
if [ "$handoff_mode" = true ]
then
  evidence='["implementation_complete","tests_passed","provider_handoff_received"]'
fi

{
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"claude-fixture","version":"1"}}}'
  printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized","params":{}}'
  printf '%s\n' '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"crewfold_get_briefing","arguments":{}}}'
  printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"crewfold_propose_completion\",\"arguments\":{\"summary\":\"Recorded Claude endpoint completed the provider-neutral work loop.\",\"handoff\":\"Claude continued from Crewfold-owned context and durable mail without provider-private transcript state.\",\"evidence_ids\":$evidence,\"changed_paths\":[\"answer.txt\"],\"checks\":[\"./check.sh\"],\"remaining_risks\":[],\"unknowns\":[],\"idempotency_key\":\"recorded-claude-completion\"}}}"
} | CREWFOLD_MCP_SOCKET="$socket_path" CREWFOLD_MCP_CAPABILITY_FILE="$capability_file" "$bridge" __mcp-stdio-bridge >"$response_file"

if [ "$(wc -l <"$response_file")" -ne 3 ] || grep -Fq '"error"' "$response_file" || grep -Fq '"isError":true' "$response_file"
then
  printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Crewfold MCP fixture call failed"}' >&2
  exit 1
fi
if [ "$handoff_mode" = true ] && ! grep -Fq 'Durable provider handoff' "$response_file"
then
  printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Crewfold durable provider handoff was absent from the briefing"}' >&2
  exit 1
fi

printf '%s\n' '{"type":"system","subtype":"init","session_id":"claude-fixture-session","mcp_servers":[{"name":"crewfold","status":"connected"}]}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"session_id":"claude-fixture-session","result":"provider report submitted","total_cost_usd":0}'
