#!/bin/sh
set -eu

state_root=${CREWFOLD_FIXTURE_HERDR_STATE:?CREWFOLD_FIXTURE_HERDR_STATE is required}
schema_path=${CREWFOLD_FIXTURE_HERDR_SCHEMA:?CREWFOLD_FIXTURE_HERDR_SCHEMA is required}
surface_root="$state_root/surfaces"
mkdir -p "$surface_root"

pane_operation() {
  value=${1#w-}
  printf '%s' "${value%%:*}"
}

surface_exists() {
  [ -f "$surface_root/$1" ]
}

write_error() {
  code=$1
  message=$2
  printf '{"id":"fixture","error":{"code":"%s","message":"%s"}}\n' "$code" "$message" >&2
  exit 1
}

write_snapshot() {
  printf '{"id":"cli:api:snapshot","result":{"type":"session_snapshot","snapshot":{"version":"0.8.0","protocol":19,"workspaces":['
  separator=''
  for surface in "$surface_root"/*
  do
    [ -f "$surface" ] || continue
    operation=$(basename "$surface")
    printf '%s{"workspace_id":"w-%s","label":"crewfold-%s"}' "$separator" "$operation" "$operation"
    separator=,
  done
  printf '],"tabs":['
  separator=''
  for surface in "$surface_root"/*
  do
    [ -f "$surface" ] || continue
    operation=$(basename "$surface")
    printf '%s{"tab_id":"w-%s:t1","workspace_id":"w-%s"}' "$separator" "$operation" "$operation"
    separator=,
  done
  printf '],"panes":['
  separator=''
  for surface in "$surface_root"/*
  do
    [ -f "$surface" ] || continue
    operation=$(basename "$surface")
    printf '%s{"pane_id":"w-%s:p1","terminal_id":"term-%s","workspace_id":"w-%s","tab_id":"w-%s:t1"}' "$separator" "$operation" "$operation" "$operation" "$operation"
    separator=,
  done
  printf '],"layouts":[],"agents":[]}}}\n'
}

if [ "$#" -eq 1 ] && [ "$1" = "--version" ]
then
  printf 'herdr 0.8.0\n'
  exit 0
fi

case "${1:-} ${2:-}" in
  "api schema")
    if [ "${3:-}" != "--json" ]
    then
      exit 2
    fi
    cat "$schema_path"
    ;;
  "api snapshot")
    write_snapshot
    ;;
  "workspace create")
    shift 2
    label=''
    while [ "$#" -gt 0 ]
    do
      case "$1" in
        --label)
          label=$2
          shift 2
          ;;
        --cwd|--env)
          shift 2
          ;;
        --no-focus)
          shift
          ;;
        *)
          exit 2
          ;;
      esac
    done
    operation=${label#crewfold-}
    if [ -z "$operation" ] || [ "$operation" = "$label" ]
    then
      write_error invalid_label "fixture requires a Crewfold workspace label"
    fi
    : >"$surface_root/$operation"
    printf '{"id":"cli:request","result":{"type":"workspace_created","workspace":{"workspace_id":"w-%s","label":"crewfold-%s"},"tab":{"tab_id":"w-%s:t1","workspace_id":"w-%s"},"root_pane":{"pane_id":"w-%s:p1","terminal_id":"term-%s","workspace_id":"w-%s","tab_id":"w-%s:t1"}}}\n' "$operation" "$operation" "$operation" "$operation" "$operation" "$operation" "$operation" "$operation"
    ;;
  "workspace close")
    operation=${3#w-}
    if ! surface_exists "$operation"
    then
      write_error workspace_not_found "workspace was not found"
    fi
    rm -f "$surface_root/$operation"
    ;;
  "pane run")
    pane=$3
    command=$4
    operation=$(pane_operation "$pane")
    if ! surface_exists "$operation"
    then
      write_error pane_not_found "pane was not found"
    fi
    log_path="$state_root/$operation.log"
    HERDR_ENV=1 HERDR_WORKSPACE_ID="w-$operation" HERDR_TAB_ID="w-$operation:t1" HERDR_PANE_ID="$pane" sh -c "$command" >"$log_path" 2>&1 </dev/null &
    printf '%s\n' "$!" >"$state_root/$operation.pid"
    ;;
  "pane process-info")
    pane=$4
    operation=$(pane_operation "$pane")
    if ! surface_exists "$operation"
    then
      write_error pane_not_found "pane was not found"
    fi
    pid=1
    if [ -f "$state_root/$operation.pid" ]
    then
      pid=$(sed -n '1p' "$state_root/$operation.pid")
    fi
    printf '{"id":"cli:request","result":{"type":"pane_process_info","process_info":{"pane_id":"%s","foreground_processes":[{"pid":%s,"name":"crewfold"}]}}}\n' "$pane" "$pid"
    ;;
  "pane read")
    pane=$3
    operation=$(pane_operation "$pane")
    if ! surface_exists "$operation"
    then
      write_error pane_not_found "pane was not found"
    fi
    if [ -f "$state_root/$operation.log" ]
    then
      cat "$state_root/$operation.log"
    fi
    ;;
  "pane send-text")
    pane=$3
    operation=$(pane_operation "$pane")
    if ! surface_exists "$operation"
    then
      write_error pane_not_found "pane was not found"
    fi
    printf '%s\n' "$4" >>"$state_root/$operation.input"
    ;;
  "pane send-keys")
    pane=$3
    operation=$(pane_operation "$pane")
    if ! surface_exists "$operation"
    then
      write_error pane_not_found "pane was not found"
    fi
    if [ "${4:-}" = "ctrl+c" ] && [ -f "$state_root/$operation.pid" ]
    then
      pid=$(sed -n '1p' "$state_root/$operation.pid")
      kill -INT "$pid" 2>/dev/null || true
    fi
    ;;
  "pane close")
    pane=$3
    operation=$(pane_operation "$pane")
    if ! surface_exists "$operation"
    then
      write_error pane_not_found "pane was not found"
    fi
    if [ -f "$state_root/$operation.pid" ]
    then
      pid=$(sed -n '1p' "$state_root/$operation.pid")
      kill -TERM "$pid" 2>/dev/null || true
    fi
    rm -f "$surface_root/$operation"
    ;;
  "terminal attach")
    printf 'fixture attached to %s\n' "$3"
    ;;
  *)
    write_error unsupported_fixture_command "unsupported recorded Herdr fixture command"
    ;;
esac
