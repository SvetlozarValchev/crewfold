{
  "schema": "urn:crewfold:schema:fixture:fake-run-scenario:v1",
  "name": "manager-supervisor-granted-plan",
  "acceptance": {
    "required_evidence": ["proposal_submitted"]
  },
  "steps": [
    {
      "kind": "completion",
      "message": "Submitted the bounded A to B to review plan.",
      "evidence": ["proposal_submitted"],
      "handoff": "The proposal remains inert until the local owner accepts it."
    }
  ],
  "management": {
    "proposals": [
      {
        "kind": "task_decomposition",
        "summary": "Create an implementation chain A to B followed by independent review.",
        "actions": [
          {
            "type": "create_task",
            "create_task": {
              "task_key": "a",
              "launch_profile_id": "@IMPLEMENT_PROFILE@",
              "title": "Implement A",
              "description": "First exact implementation task.",
              "priority": 70,
              "budget": {"token_limit": 4000, "cost_cents": 100, "time_seconds": 900}
            }
          },
          {
            "type": "create_task",
            "create_task": {
              "task_key": "b",
              "launch_profile_id": "@IMPLEMENT_PROFILE@",
              "title": "Implement B",
              "description": "Second implementation task after A.",
              "priority": 60,
              "budget": {"token_limit": 4000, "cost_cents": 100, "time_seconds": 900}
            }
          },
          {
            "type": "create_task",
            "create_task": {
              "task_key": "review",
              "launch_profile_id": "@REVIEW_PROFILE@",
              "title": "Independently review A and B",
              "description": "Review uses a separate exact agent/profile capability.",
              "priority": 50,
              "budget": {"token_limit": 3000, "cost_cents": 100, "time_seconds": 900}
            }
          },
          {
            "type": "add_dependency",
            "add_dependency": {
              "task": {"proposal_task_key": "b"},
              "depends_on": {"proposal_task_key": "a"}
            }
          },
          {
            "type": "add_dependency",
            "add_dependency": {
              "task": {"proposal_task_key": "review"},
              "depends_on": {"proposal_task_key": "b"}
            }
          },
          {
            "type": "declare_claim_requirement",
            "declare_claim_requirement": {
              "task": {"proposal_task_key": "a"},
              "kind": "component",
              "target": "manager-supervisor-fixture",
              "mode": "exclusive",
              "conflict_policy": "deny_new"
            }
          }
        ]
      }
    ],
    "probe_reserved_acceptance": true
  }
}
