{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:cli:repair-inspect-response:v1",
  "title": "Crewfold offline repair inspection response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "status", "path", "event_sequence", "copied", "artifact_status", "findings", "truncated"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:cli:repair-inspect-response:v1"},
    "type": {"const": "repair_inspect"},
    "status": {"enum": ["ok", "guidance_required", "uninspectable"]},
    "path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\x00]*$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_sha256", "catalog_sha256"],
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "event_sequence": {"type": "integer", "minimum": 0},
    "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "copied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_bytes", "wal_bytes", "shm_bytes", "wal_present", "shm_present"],
      "properties": {
        "database_bytes": {"type": "integer", "minimum": 0},
        "wal_bytes": {"type": "integer", "minimum": 0},
        "shm_bytes": {"type": "integer", "minimum": 0},
        "wal_present": {"type": "boolean"},
        "shm_present": {"type": "boolean"}
      }
    },
    "artifact_status": {"enum": ["ok", "warning", "failed", "not_run"]},
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "summary", "action"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_]+$"},
          "status": {"enum": ["ok", "warning", "failed"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
          "action": {"enum": ["retry", "rebuild_derived_index", "retire_lost_runtime", "free_space", "restore_verified_backup", "report_defect"]}
        }
      }
    },
    "truncated": {"type": "boolean"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_]+$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "uninspectable"}}, "required": ["status"]},
      "then": {"required": ["error"], "not": {"anyOf": [{"required": ["baseline"]}, {"required": ["logical_sha256"]}]}},
      "else": {"not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
      "then": {"required": ["baseline", "logical_sha256"]}
    }
  ]
}
