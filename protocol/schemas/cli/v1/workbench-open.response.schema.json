{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:cli:workbench-open-response:v1",
  "title": "Crewfold workbench open response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "status", "origin", "expires_at"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:cli:workbench-open-response:v1"},
    "type": {"const": "workbench_open"},
    "status": {"const": "opened"},
    "origin": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
