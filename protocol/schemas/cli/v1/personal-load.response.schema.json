{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:cli:personal-load-report:v1",
  "title": "Crewfold personal-100 load report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "status", "environment", "counts", "logical_sha256", "timings", "resources", "assertions"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:cli:personal-load-report:v1"},
    "profile": {"const": "personal-100"},
    "status": {"enum": ["ok", "failed"]},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch", "kernel", "go_version", "sqlite_version", "cpu", "logical_cpus", "memory_bytes"],
      "properties": {
        "goos": {"type": "string", "minLength": 1, "maxLength": 32},
        "goarch": {"type": "string", "minLength": 1, "maxLength": 32},
        "kernel": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00]*$"},
        "go_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\x00]*$"},
        "sqlite_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\x00]*$"},
        "cpu": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00]*$"},
        "logical_cpus": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaces", "projects", "agents", "objectives", "tasks", "known_events", "noisy_project_events"],
      "properties": {
        "workspaces": {"type": "integer", "minimum": 0, "maximum": 1},
        "projects": {"type": "integer", "minimum": 0, "maximum": 10},
        "agents": {"type": "integer", "minimum": 0, "maximum": 100},
        "objectives": {"type": "integer", "minimum": 0, "maximum": 10},
        "tasks": {"type": "integer", "minimum": 0, "maximum": 1000},
        "known_events": {"type": "integer", "minimum": 0, "maximum": 100000},
        "noisy_project_events": {"type": "integer", "minimum": 0, "maximum": 80000}
      }
    },
    "logical_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "timings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repetitions", "p50_microseconds", "p95_microseconds", "p99_microseconds", "max_microseconds"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
          "repetitions": {"type": "integer", "minimum": 1},
          "p50_microseconds": {"type": "integer", "minimum": 0},
          "p95_microseconds": {"type": "integer", "minimum": 0},
          "p99_microseconds": {"type": "integer", "minimum": 0},
          "max_microseconds": {"type": "integer", "minimum": 0}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_rss_bytes", "database_bytes", "artifact_bytes", "goroutines", "open_fds"],
      "properties": {
        "peak_rss_bytes": {"type": "integer", "minimum": 0},
        "database_bytes": {"type": "integer", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0},
        "goroutines": {"type": "integer", "minimum": 0},
        "open_fds": {"type": "integer", "minimum": -1}
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "actual", "limit", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"},
          "passed": {"type": "boolean"},
          "actual": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 0},
          "unit": {"enum": ["count", "events", "microseconds", "bytes"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "workspaces": {"const": 1},
              "projects": {"const": 10},
              "agents": {"const": 100},
              "objectives": {"const": 10},
              "tasks": {"const": 1000},
              "known_events": {"const": 100000},
              "noisy_project_events": {"const": 80000}
            }
          },
          "logical_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "timings": {"minItems": 5},
          "resources": {
            "properties": {
              "peak_rss_bytes": {"minimum": 1},
              "database_bytes": {"minimum": 1},
              "goroutines": {"minimum": 1},
              "open_fds": {"minimum": 0}
            }
          },
          "assertions": {"minItems": 1}
        }
      }
    }
  ]
}
