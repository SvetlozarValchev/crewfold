{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:cli:error-response:v1",
  "title": "Crewfold CLI error response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "error"],
  "properties": {
    "schema": {
      "const": "urn:crewfold:schema:cli:error-response:v1"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
