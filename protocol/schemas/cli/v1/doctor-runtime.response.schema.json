{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:runtime:herdr-probe:v1",
  "title": "Crewfold Herdr runtime doctor response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtime", "status", "binary", "session", "checks"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:runtime:herdr-probe:v1"},
    "runtime": {"const": "herdr"},
    "status": {"enum": ["ok", "failed"]},
    "binary": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "session": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "protocol": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"enum": ["binary", "schema", "session"]},
          "status": {"enum": ["ok", "failed"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
