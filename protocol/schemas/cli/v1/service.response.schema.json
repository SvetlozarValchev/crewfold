{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:cli:service-response:v1",
  "title": "Crewfold service lifecycle response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "action", "status", "unit_path", "data_dir", "socket"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:cli:service-response:v1"},
    "type": {"const": "service"},
    "action": {"enum": ["install", "start", "stop", "status"]},
    "status": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z_-]*$"},
    "unit_path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\x00\\r\\n]*$"},
    "data_dir": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\x00\\r\\n]*$"},
    "socket": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\x00\\r\\n]*$"},
    "codex_tool_network_access": {"type": "boolean"}
  }
}
