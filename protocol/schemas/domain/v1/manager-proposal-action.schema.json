{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:manager-proposal-action:v1",
  "title": "Crewfold manager proposal action v1",
  "oneOf": [
    {"$ref": "#/$defs/create_task_action"},
    {"$ref": "#/$defs/add_dependency_action"},
    {"$ref": "#/$defs/declare_claim_requirement_action"},
    {"$ref": "#/$defs/assign_task_action"},
    {"$ref": "#/$defs/request_review_action"},
    {"$ref": "#/$defs/request_action_action"}
  ],
  "$defs": {
    "task_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["task_id", "expected_task_revision"], "properties": {"task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}, "expected_task_revision": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["proposal_task_key"], "properties": {"proposal_task_key": {"type": "string", "minLength": 1, "maxLength": 64}}}
      ]
    },
	"existing_task_ref": {"type": "object", "additionalProperties": false, "required": ["task_id", "expected_task_revision"], "properties": {"task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}, "expected_task_revision": {"type": "integer", "minimum": 1}}},
    "create_task": {"type": "object", "additionalProperties": false, "required": ["task_key", "launch_profile_id", "title", "priority", "budget"], "properties": {"task_key": {"type": "string", "minLength": 1, "maxLength": 64}, "launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 256}, "description": {"type": "string", "maxLength": 4096}, "priority": {"type": "integer", "minimum": 0, "maximum": 1000}, "budget": {"$ref": "budget.schema.json"}}},
    "add_dependency": {"type": "object", "additionalProperties": false, "required": ["task", "depends_on"], "properties": {"task": {"$ref": "#/$defs/task_ref"}, "depends_on": {"$ref": "#/$defs/task_ref"}}},
    "declare_claim_requirement": {"type": "object", "additionalProperties": false, "required": ["task", "kind", "target", "mode", "conflict_policy"], "properties": {"task": {"$ref": "#/$defs/task_ref"}, "kind": {"enum": ["path", "component", "operation"]}, "target": {"type": "string", "minLength": 1, "maxLength": 512}, "mode": {"enum": ["exclusive", "shared", "advisory"]}, "conflict_policy": {"enum": ["notify", "deny_new", "pause_scheduling", "request_resolution"]}}},
    "assign_task": {"type": "object", "additionalProperties": false, "required": ["task", "launch_profile_id"], "properties": {"task": {"$ref": "#/$defs/existing_task_ref"}, "launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"}}},
    "request_review": {"type": "object", "additionalProperties": false, "required": ["task", "launch_profile_id", "title", "priority", "budget"], "properties": {"task": {"$ref": "#/$defs/existing_task_ref"}, "launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 256}, "description": {"type": "string", "maxLength": 4096}, "priority": {"type": "integer", "minimum": 0, "maximum": 1000}, "budget": {"$ref": "budget.schema.json"}}},
    "request_action": {"oneOf": [
      {"type":"object","additionalProperties":false,"required":["response","target_run_id","reason","expected_revision"],"properties":{"response":{"const":"resume_run"},"target_run_id":{"type":"string","pattern":"^run_[0-9a-f]{32}$"},"reason":{"type":"string","minLength":1,"maxLength":1024},"expected_revision":{"type":"integer","minimum":1}}},
      {"type":"object","additionalProperties":false,"required":["response","target_run_id","reason","expected_revision"],"properties":{"response":{"const":"stop_run"},"target_run_id":{"type":"string","pattern":"^run_[0-9a-f]{32}$"},"reason":{"type":"string","minLength":1,"maxLength":1024},"expected_revision":{"type":"integer","minimum":1}}},
      {"type":"object","additionalProperties":false,"required":["response","target_task_id","reason","expected_revision"],"properties":{"response":{"const":"retry_task"},"target_task_id":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},"reason":{"type":"string","minLength":1,"maxLength":1024},"expected_revision":{"type":"integer","minimum":1}}},
      {"type":"object","additionalProperties":false,"required":["response","target_task_id","launch_profile_id","reason","expected_revision"],"properties":{"response":{"const":"reassign_task"},"target_task_id":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},"launch_profile_id":{"type":"string","pattern":"^lprof_[0-9a-f]{32}$"},"reason":{"type":"string","minLength":1,"maxLength":1024},"expected_revision":{"type":"integer","minimum":1}}}
    ]},
    "create_task_action": {"type": "object", "additionalProperties": false, "required": ["id", "ordinal", "type", "create_task"], "properties": {"id": {"type": "string", "pattern": "^mpact_[0-9a-f]{32}$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "type": {"const": "create_task"}, "create_task": {"$ref": "#/$defs/create_task"}}},
    "add_dependency_action": {"type": "object", "additionalProperties": false, "required": ["id", "ordinal", "type", "add_dependency"], "properties": {"id": {"type": "string", "pattern": "^mpact_[0-9a-f]{32}$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "type": {"const": "add_dependency"}, "add_dependency": {"$ref": "#/$defs/add_dependency"}}},
    "declare_claim_requirement_action": {"type": "object", "additionalProperties": false, "required": ["id", "ordinal", "type", "declare_claim_requirement"], "properties": {"id": {"type": "string", "pattern": "^mpact_[0-9a-f]{32}$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "type": {"const": "declare_claim_requirement"}, "declare_claim_requirement": {"$ref": "#/$defs/declare_claim_requirement"}}},
    "assign_task_action": {"type": "object", "additionalProperties": false, "required": ["id", "ordinal", "type", "assign_task"], "properties": {"id": {"type": "string", "pattern": "^mpact_[0-9a-f]{32}$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "type": {"const": "assign_task"}, "assign_task": {"$ref": "#/$defs/assign_task"}}},
    "request_review_action": {"type": "object", "additionalProperties": false, "required": ["id", "ordinal", "type", "request_review"], "properties": {"id": {"type": "string", "pattern": "^mpact_[0-9a-f]{32}$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "type": {"const": "request_review"}, "request_review": {"$ref": "#/$defs/request_review"}}},
    "request_action_action": {"type": "object", "additionalProperties": false, "required": ["id", "ordinal", "type", "request_action"], "properties": {"id": {"type": "string", "pattern": "^mpact_[0-9a-f]{32}$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "type": {"const": "request_action"}, "request_action": {"$ref": "#/$defs/request_action"}}}
  }
}
