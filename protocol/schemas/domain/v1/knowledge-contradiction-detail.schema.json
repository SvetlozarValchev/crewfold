{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:knowledge-contradiction-detail:v1",
  "title": "Crewfold knowledge contradiction detail v1",
  "type": "object",
  "additionalProperties": false,
	"required": ["contradiction", "left_revision", "right_revision", "authority_check_count", "authority_checks"],
  "properties": {
    "contradiction": {"$ref": "knowledge-contradiction.schema.json"},
    "left_revision": {"$ref": "knowledge-revision.schema.json"},
    "right_revision": {"$ref": "knowledge-revision.schema.json"},
	"authority_check_count": {"type": "integer", "minimum": 0, "description": "Total authority attempts, including any omitted from the bounded ledger sample."},
    "authority_checks": {
      "type": "array",
	  "maxItems": 200,
	  "description": "The newest at most 200 authority checks in event_sequence descending then ID descending order.",
      "items": {"$ref": "knowledge-contradiction-authority.schema.json"}
    }
  }
}
