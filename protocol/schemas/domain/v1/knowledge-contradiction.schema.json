{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:knowledge-contradiction:v1",
  "title": "Crewfold canonical knowledge contradiction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "workspace_id", "project_id", "left_revision_id", "right_revision_id",
    "status", "state_revision", "report_note", "reported_at", "reported_by", "reported_by_type"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^kcon_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "left_revision_id": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
    "right_revision_id": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
    "status": {"enum": ["proposed", "open", "resolved", "dismissed"]},
	"state_revision": {"type": "integer", "minimum": 1},
	"report_note": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "Required UTF-8 text; the implementation enforces the 2048 limit on encoded bytes."},
    "reported_at": {"type": "string", "format": "date-time"},
    "reported_by": {"type": "string", "minLength": 1, "maxLength": 128},
	"reported_by_type": {"enum": ["human", "agent_run"]},
    "confirmed_at": {"type": "string", "format": "date-time"},
	"confirmed_by": {"const": "local-owner"},
	"confirmed_by_type": {"const": "human"},
	"confirm_note": {"type": "string", "maxLength": 2048, "description": "Optional UTF-8 text bounded to 2048 encoded bytes."},
	"confirm_event_sequence": {"type": "integer", "minimum": 1},
    "dismissed_at": {"type": "string", "format": "date-time"},
	"dismissed_by": {"const": "local-owner"},
	"dismissed_by_type": {"const": "human"},
	"dismiss_note": {"type": "string", "maxLength": 2048, "description": "Optional UTF-8 text bounded to 2048 encoded bytes."},
	"dismiss_event_sequence": {"type": "integer", "minimum": 1},
	"resolution_reason": {"enum": ["participant_stale", "participant_superseded"]},
	"resolved_at": {"type": "string", "format": "date-time"},
	"resolved_by": {"const": "local-owner"},
	"resolved_by_type": {"const": "human"},
	"resolution_note": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "Deterministic UTF-8 explanation bounded to 2048 encoded bytes."},
	"resolution_event_sequence": {"type": "integer", "minimum": 1},
	"resolution_cause_event_sequence": {"type": "integer", "minimum": 1, "description": "The exact knowledge governance event that made one contradiction participant stale or superseded."}
  },
	"allOf": [
	  {
		"if": {"properties": {"reported_by_type": {"const": "human"}}, "required": ["reported_by_type"]},
		"then": {"properties": {"reported_by": {"const": "local-owner"}}},
		"else": {"properties": {"reported_by": {"pattern": "^run_[0-9a-f]{32}$"}}}
	  }
	],
	"oneOf": [
	  {
		"properties": {"status": {"const": "proposed"}, "state_revision": {"const": 1}},
		"required": ["status"],
		"not": {"anyOf": [
		  {"required": ["confirmed_at"]}, {"required": ["confirmed_by"]}, {"required": ["confirmed_by_type"]}, {"required": ["confirm_note"]}, {"required": ["confirm_event_sequence"]},
		  {"required": ["dismissed_at"]}, {"required": ["dismissed_by"]}, {"required": ["dismissed_by_type"]}, {"required": ["dismiss_note"]}, {"required": ["dismiss_event_sequence"]},
		  {"required": ["resolution_reason"]}, {"required": ["resolved_at"]}, {"required": ["resolved_by"]}, {"required": ["resolved_by_type"]}, {"required": ["resolution_note"]}, {"required": ["resolution_event_sequence"]}, {"required": ["resolution_cause_event_sequence"]}
		]}
	  },
	  {
		"properties": {"status": {"const": "open"}, "state_revision": {"const": 2}},
		"required": ["status", "confirmed_at", "confirmed_by", "confirmed_by_type", "confirm_event_sequence"],
		"not": {"anyOf": [
		  {"required": ["dismissed_at"]}, {"required": ["dismissed_by"]}, {"required": ["dismissed_by_type"]}, {"required": ["dismiss_note"]}, {"required": ["dismiss_event_sequence"]},
		  {"required": ["resolution_reason"]}, {"required": ["resolved_at"]}, {"required": ["resolved_by"]}, {"required": ["resolved_by_type"]}, {"required": ["resolution_note"]}, {"required": ["resolution_event_sequence"]}, {"required": ["resolution_cause_event_sequence"]}
		]}
	  },
	  {
		"properties": {"status": {"const": "dismissed"}, "state_revision": {"enum": [2, 3]}},
		"required": ["status", "dismissed_at", "dismissed_by", "dismissed_by_type", "dismiss_event_sequence"],
		"not": {"anyOf": [
		  {"required": ["resolution_reason"]}, {"required": ["resolved_at"]}, {"required": ["resolved_by"]}, {"required": ["resolved_by_type"]}, {"required": ["resolution_note"]}, {"required": ["resolution_event_sequence"]}, {"required": ["resolution_cause_event_sequence"]}
		]},
		"oneOf": [
		  {
			"properties": {"state_revision": {"const": 2}},
			"not": {"anyOf": [
			{"required": ["confirmed_at"]}, {"required": ["confirmed_by"]}, {"required": ["confirmed_by_type"]}, {"required": ["confirm_note"]}, {"required": ["confirm_event_sequence"]}
			]}
		  },
		  {
			"properties": {"state_revision": {"const": 3}},
			"required": ["confirmed_at", "confirmed_by", "confirmed_by_type", "confirm_event_sequence"]
		  }
		]
	  },
	  {
		"properties": {"status": {"const": "resolved"}, "state_revision": {"const": 3}},
		"required": ["status", "confirmed_at", "confirmed_by", "confirmed_by_type", "confirm_event_sequence", "resolved_at", "resolved_by", "resolved_by_type", "resolution_reason", "resolution_note", "resolution_event_sequence", "resolution_cause_event_sequence"],
		"not": {"anyOf": [
		  {"required": ["dismissed_at"]}, {"required": ["dismissed_by"]}, {"required": ["dismissed_by_type"]}, {"required": ["dismiss_note"]}, {"required": ["dismiss_event_sequence"]}
		]}
	  }
	]
}
