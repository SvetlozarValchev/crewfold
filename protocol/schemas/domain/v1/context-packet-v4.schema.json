{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-packet:v4",
  "title": "Crewfold immutable context packet v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "workspace_id", "project_id", "task_id", "agent_id", "checkout_id",
    "role", "task", "checkout", "dependencies", "dependents", "dependent_task_count", "inbox", "participant_threads",
    "requested_knowledge_revision_ids", "accepted_knowledge", "policy", "live_context",
    "reporting", "included", "excluded", "budget", "as_of_event_sequence", "content_hash",
    "byte_size", "created_at", "created_by"
  ],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:domain:context-packet:v4"},
    "id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "role": {"$ref": "context-packet-v3.schema.json#/$defs/role"},
    "task": {"$ref": "#/$defs/task"},
    "checkout": {"$ref": "context-packet-v3.schema.json#/$defs/checkout"},
    "dependencies": {"type": "array", "maxItems": 32, "items": {"$ref": "context-packet-v3.schema.json#/$defs/dependency"}},
    "dependents": {"type": "array", "maxItems": 32, "items": {"$ref": "context-packet-v3.schema.json#/$defs/dependency"}},
    "dependent_task_count": {"type": "integer", "minimum": 0},
    "inbox": {"$ref": "context-packet-v3.schema.json#/$defs/inbox"},
    "participant_threads": {"type": "array", "maxItems": 8, "items": {"$ref": "participant-thread.schema.json"}},
    "requested_knowledge_revision_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"}},
    "accepted_knowledge": {"type": "array", "maxItems": 16, "items": {"$ref": "knowledge-revision.schema.json"}},
    "policy": {"$ref": "#/$defs/policy"},
    "live_context": {"$ref": "live-context-policy.schema.json"},
    "reporting": {"$ref": "context-packet-v3.schema.json#/$defs/reporting"},
    "included": {"type": "array", "minItems": 3, "maxItems": 128, "items": {"$ref": "context-packet-v3.schema.json#/$defs/selection"}},
    "excluded": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/exclusion"}},
    "budget": {"$ref": "#/$defs/budget"},
    "as_of_event_sequence": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 32768},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"const": "local-owner"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "assignment_id", "title", "priority", "budget", "revision"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
        "assignment_id": {"type": "string", "pattern": "^asg_[0-9a-f]{32}$"},
        "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "priority": {"type": "integer", "minimum": 0},
        "budget": {"$ref": "budget.schema.json"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tools", "denied_operations", "approval_required"],
      "properties": {
        "allowed_tools": {"const": [
          "crewfold_acknowledge_context_delta",
          "crewfold_acknowledge_message",
          "crewfold_get_briefing",
          "crewfold_get_context_delta",
          "crewfold_get_status",
          "crewfold_list_inbox",
          "crewfold_propose_knowledge",
          "crewfold_propose_completion",
          "crewfold_publish_artifact",
          "crewfold_read_message",
          "crewfold_report_blocked",
          "crewfold_report_contradiction",
          "crewfold_report_progress",
          "crewfold_send_message"
        ]},
        "denied_operations": {"const": ["change another run or task", "push or merge source", "deploy", "message a person or broadcast", "read unscoped context"]},
        "approval_required": {"const": ["shared repository mutation", "external side effect", "destructive operation"]}
      }
    },
    "budget_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["limit_bytes", "used_bytes", "remaining_bytes"],
      "properties": {
        "limit_bytes": {"type": "integer", "minimum": 1},
        "used_bytes": {"type": "integer", "minimum": 0},
        "remaining_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "knowledge", "collaboration"],
      "properties": {
        "total": {"allOf": [{"$ref": "#/$defs/budget_usage"}, {"properties": {"limit_bytes": {"const": 32768}}}]},
        "knowledge": {"allOf": [{"$ref": "#/$defs/budget_usage"}, {"properties": {"limit_bytes": {"const": 12288}}}]},
        "collaboration": {"allOf": [{"$ref": "#/$defs/budget_usage"}, {"properties": {"limit_bytes": {"const": 8192}}}]}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["section", "reason"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "requested_revision_id": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
        "replacement_revision_id": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
        "reason_code": {"enum": ["proposed", "rejected", "stale", "superseded", "out_of_scope", "over_item_limit", "over_budget"]},
        "reason": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
