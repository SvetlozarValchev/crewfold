{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:run-timeline-entry:v1",
  "title": "Crewfold run timeline entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "run_id", "kind", "evidence", "recorded_at"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "kind": {"type": "string", "minLength": 1, "maxLength": 128},
    "message": {"type": "string", "maxLength": 4096},
    "evidence": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
