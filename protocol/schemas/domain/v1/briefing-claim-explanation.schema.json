{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:briefing-claim-explanation:v1",
  "title": "Crewfold management briefing claim explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["briefing_id", "claim", "evaluated_at", "provenance", "diagnoses"],
  "properties": {
    "briefing_id": {"type": "string", "pattern": "^briefing_[0-9a-f]{32}$"},
    "claim": {"$ref": "management-briefing.schema.json#/$defs/claim"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "management-briefing.schema.json#/$defs/claim_source"}},
    "diagnoses": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
  }
}
