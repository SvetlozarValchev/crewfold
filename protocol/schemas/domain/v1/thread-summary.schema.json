{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:thread-summary:v1",
  "title": "Crewfold message thread summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["thread", "message_count", "agent_ids"],
  "properties": {
    "thread": {"$ref": "message-thread.schema.json"},
    "message_count": {"type": "integer", "minimum": 0},
    "agent_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"}
    }
  }
}
