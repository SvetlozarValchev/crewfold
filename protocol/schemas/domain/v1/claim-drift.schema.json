{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:claim-drift:v1",
  "title": "Crewfold claim drift v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "claim_id", "task_id", "checkout_id", "path", "observation_gap", "status", "first_observed_at", "last_observed_at", "revision"],
  "properties": {
    "id": {"type": "string", "pattern": "^drift_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "claim_id": {"type": "string", "pattern": "^claim_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "path": {"type": "string", "minLength": 1},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "observation_gap": {"type": "boolean"},
    "status": {"enum": ["open", "resolved"]},
    "first_observed_at": {"type": "string", "format": "date-time"},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1}
  }
}
