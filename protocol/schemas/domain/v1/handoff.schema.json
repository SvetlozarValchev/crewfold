{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:handoff:v1",
  "title": "Crewfold handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "task_id", "summary", "evidence", "created_at", "created_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^handoff_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidence": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1}
  }
}
