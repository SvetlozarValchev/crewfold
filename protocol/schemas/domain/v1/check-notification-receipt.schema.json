{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-notification-receipt:v1",
  "type":"object","additionalProperties":false,
  "required":["id","check_result_id","freshness_revision","duty","recipient_agent_id","recipient_agent_revision","message_id","created_at"],
  "properties":{
    "id":{"type":"string","pattern":"^checknotice_[0-9a-f]{32}$"},
    "check_result_id":{"type":"string","pattern":"^checkresult_[0-9a-f]{32}$"},
    "freshness_revision":{"type":"integer","minimum":1},
    "route_id":{"type":"string","pattern":"^checkroute_[0-9a-f]{32}$"},
    "duty":{"enum":["task_owner","evidence_review","coordination"]},
    "recipient_agent_id":{"type":"string","pattern":"^agent_[0-9a-f]{32}$"},
    "recipient_agent_revision":{"type":"integer","minimum":1},
    "assignment_id":{"type":"string","pattern":"^asg_[0-9a-f]{32}$"},
    "assignment_revision":{"type":"integer","minimum":1},
    "message_id":{"type":"string","pattern":"^msg_[0-9a-f]{32}$"},
    "created_at":{"type":"string","format":"date-time"}
  },
  "dependentRequired":{"assignment_id":["assignment_revision"],"assignment_revision":["assignment_id"]}
}
