{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:outcome-assessment-input:v1",
  "title": "Crewfold owner-authored outcome assessment input v1",
  "$comment": "Each text limit is enforced in UTF-8 bytes. The server also requires no more than 256 total child records and a canonical assessment representation no larger than 49152 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["conclusion", "delivered_scope", "unmet_scope", "decision_revision_ids", "evidence", "effects", "deviations", "risks", "unknowns", "follow_up_task_ids", "owner_attention"],
  "properties": {
    "conclusion": {"enum": ["achieved", "partial", "not_achieved", "unknown"]},
    "delivered_scope": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "unmet_scope": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "decision_revision_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"}},
    "evidence": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "effects": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/effect"}},
    "deviations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/deviation"}},
    "risks": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/risk"}},
    "unknowns": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/unknown"}},
    "follow_up_task_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}},
    "owner_attention": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/owner_attention"}}
  },
  "allOf": [
    {"if": {"properties": {"conclusion": {"const": "achieved"}}, "required": ["conclusion"]}, "then": {"properties": {"delivered_scope": {"minItems": 1}, "unmet_scope": {"maxItems": 0}}}},
    {"if": {"properties": {"conclusion": {"const": "partial"}}, "required": ["conclusion"]}, "then": {"properties": {"delivered_scope": {"minItems": 1}, "unmet_scope": {"minItems": 1}}}},
    {"if": {"properties": {"conclusion": {"const": "not_achieved"}}, "required": ["conclusion"]}, "then": {"properties": {"delivered_scope": {"maxItems": 0}, "unmet_scope": {"minItems": 1}}}},
    {"if": {"properties": {"conclusion": {"const": "unknown"}}, "required": ["conclusion"]}, "then": {"properties": {"unknowns": {"minItems": 1}}}}
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": {"enum": ["handoff", "check_requirement_evidence"]},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["source_type", "source_id"], "properties": {"source_type": {"const": "handoff"}, "source_id": {"type": "string", "pattern": "^handoff_[0-9a-f]{32}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["source_type", "source_id"], "properties": {"source_type": {"const": "check_requirement_evidence"}, "source_id": {"type": "string", "pattern": "^checkevidence_[0-9a-f]{32}$"}}}
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction", "summary"],
      "properties": {
        "kind": {"enum": ["compatibility", "stability"]},
        "direction": {"enum": ["positive", "neutral", "negative", "uncertain"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": {"enum": ["scope_change", "duplicate_work"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "related_task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "summary"],
      "properties": {
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "mitigation": {"type": "string", "maxLength": 2048}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 2048}}
    },
    "owner_attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urgency", "action", "reason"],
      "properties": {
        "urgency": {"enum": ["now", "next", "later"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 2048},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
