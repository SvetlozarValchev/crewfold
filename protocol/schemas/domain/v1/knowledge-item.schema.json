{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:knowledge-item:v1",
  "title": "Crewfold canonical knowledge item v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "type", "created_at", "created_by", "created_by_type"],
  "properties": {
    "id": {"type": "string", "pattern": "^know_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "task_scope_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "type": {"enum": ["decision", "finding"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_by_type": {"enum": ["human", "agent_run", "subsystem", "integration"]}
  }
}
