{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-result-freshness:v1",
  "type":"object","additionalProperties":false,
  "required":["id","check_result_id","revision","status","reason","initially_eligible","ever_stale","observation","created_at","created_by"],
  "properties":{
    "id":{"type":"string","pattern":"^checkfresh_[0-9a-f]{32}$"},
    "check_result_id":{"type":"string","pattern":"^checkresult_[0-9a-f]{32}$"},
    "revision":{"type":"integer","minimum":1},
    "status":{"enum":["fresh","stale","unknown"]},
    "reason":{"type":"string","minLength":1,"maxLength":4096},
    "initially_eligible":{"type":"boolean"},
    "ever_stale":{"type":"boolean"},
    "observation":{"$ref":"check-git-observation.schema.json"},
    "created_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","minLength":1}
  }
}
