{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:workstream-delivery:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective_id", "objective_revision", "state", "sha256", "task_count", "completed_tasks", "verification_tasks", "passing_verifications", "evidence", "blockers"],
  "properties": {
    "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "objective_revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["in_progress", "blocked", "verified_awaiting_owner_acceptance", "accepted", "rejected"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_count": {"type": "integer", "minimum": 0},
    "completed_tasks": {"type": "integer", "minimum": 0},
    "verification_tasks": {"type": "integer", "minimum": 0},
    "passing_verifications": {"type": "integer", "minimum": 0},
    "evidence": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "blockers": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "decision_reason": {"type": "string", "maxLength": 2048},
    "decision_at": {"type": "string", "format": "date-time"},
    "decision_event_sequence": {"type": "integer", "minimum": 1}
  }
}
