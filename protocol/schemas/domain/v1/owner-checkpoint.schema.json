{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:owner-checkpoint:v1",
  "title": "Crewfold owner checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "scope_type", "scope_id", "event_sequence", "created_at", "created_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^outcpnt_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "scope_type": {"enum": ["task", "objective", "project", "workspace"]},
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "event_sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"const": "local-owner"}
  },
  "oneOf": [
    {"required": ["scope_type", "scope_id"], "properties": {"scope_type": {"const": "task"}, "scope_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}}},
    {"required": ["scope_type", "scope_id"], "properties": {"scope_type": {"const": "objective"}, "scope_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"}}},
    {"required": ["scope_type", "scope_id"], "properties": {"scope_type": {"const": "project"}, "scope_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"}}},
    {"required": ["scope_type", "scope_id"], "properties": {"scope_type": {"const": "workspace"}, "scope_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"}}}
  ]
}
