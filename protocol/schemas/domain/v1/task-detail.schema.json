{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:task-detail:v1",
  "title": "Crewfold task detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "dependencies", "readiness"],
  "properties": {
    "task": {"$ref": "task.schema.json"},
    "dependencies": {"type": "array", "items": {"$ref": "task-dependency.schema.json"}},
    "assignment": {"$ref": "task-assignment.schema.json"},
    "readiness": {"$ref": "task-readiness.schema.json"}
  }
}
