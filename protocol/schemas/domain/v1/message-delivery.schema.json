{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:message-delivery:v1",
  "title": "Crewfold message recipient delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "recipient_agent_id", "recipient_name", "status", "queued_at", "wake_status"],
  "properties": {
    "message_id": {"type": "string", "pattern": "^msg_[0-9a-f]{32}$"},
    "recipient_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "recipient_name": {"type": "string", "minLength": 1, "maxLength": 63},
    "status": {"enum": ["queued", "delivered", "read", "acknowledged"]},
    "queued_at": {"type": "string", "format": "date-time"},
    "delivered_at": {"type": "string", "format": "date-time"},
    "read_at": {"type": "string", "format": "date-time"},
    "acknowledged_at": {"type": "string", "format": "date-time"},
    "delivered_run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "wake_status": {"enum": ["not_requested", "pending", "leased", "succeeded", "failed"]},
    "wake_diagnostic": {"type": "string", "maxLength": 1024}
  }
}
