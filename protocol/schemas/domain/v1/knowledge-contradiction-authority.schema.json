{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:knowledge-contradiction-authority:v1",
  "title": "Crewfold knowledge contradiction authority check v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "workspace_id", "contradiction_id", "action", "actor", "outcome", "reason",
    "idempotency_key", "request_hash", "event_sequence", "created_at"
  ],
  "properties": {
	"id": {"type": "string", "pattern": "^kcauth_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "contradiction_id": {"type": "string", "pattern": "^kcon_[0-9a-f]{32}$"},
    "action": {"enum": ["confirm", "dismiss"]},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
		"type": {"enum": ["human", "agent_run"]}
      }
    },
    "outcome": {"enum": ["allowed", "denied"]},
	"reason": {"enum": ["workspace_owner", "actor_not_workspace_owner"]},
	"note": {"type": "string", "maxLength": 2048, "description": "Optional UTF-8 text bounded to 2048 encoded bytes."},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_sequence": {"type": "integer", "minimum": 1},
	"created_at": {"type": "string", "format": "date-time"}
	},
	"allOf": [
	  {
		"if": {"properties": {"outcome": {"const": "allowed"}}, "required": ["outcome"]},
		"then": {"properties": {"reason": {"const": "workspace_owner"}, "actor": {"properties": {"id": {"const": "local-owner"}, "type": {"const": "human"}}}}},
		"else": {"properties": {"reason": {"const": "actor_not_workspace_owner"}, "actor": {"properties": {"id": {"pattern": "^run_[0-9a-f]{32}$"}, "type": {"const": "agent_run"}}}}}
	  }
	]
}
