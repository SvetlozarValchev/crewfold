{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-definition:v1",
  "type":"object","additionalProperties":false,
  "required":["id","workspace_id","project_id","name","executable","arguments","working_directory","timeout_millis","output_byte_limit","content_revision","content_sha256","status","revision","created_at","updated_at","created_by","updated_by"],
  "properties":{
    "id":{"type":"string","pattern":"^checkdef_[0-9a-f]{32}$"},
    "workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},
    "project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},
    "name":{"type":"string","minLength":1,"maxLength":128},
    "executable":{"type":"string","minLength":1,"maxLength":4096},
    "arguments":{"type":"array","maxItems":64,"items":{"type":"string","maxLength":4096,"pattern":"^[^\\x00]*$"}},
    "working_directory":{"type":"string","maxLength":4096},
    "timeout_millis":{"type":"integer","minimum":100,"maximum":3600000},
    "output_byte_limit":{"type":"integer","minimum":1024,"maximum":1048576},
    "content_revision":{"type":"integer","minimum":1},
    "content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"enum":["active","retired"]},
    "revision":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","minLength":1},
    "updated_by":{"type":"string","minLength":1}
  }
}
