{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-explanation:v3",
  "title": "Crewfold context selection explanation v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "content_hash", "byte_size", "included", "excluded", "budget"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 32768},
    "included": {"type": "array", "maxItems": 128, "items": {"$ref": "context-packet-v3.schema.json#/$defs/selection"}},
    "excluded": {"type": "array", "maxItems": 128, "items": {"$ref": "context-packet-v4.schema.json#/$defs/exclusion"}},
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "knowledge", "collaboration"],
      "properties": {
        "total": {"$ref": "context-packet-v4.schema.json#/$defs/budget_usage"},
        "knowledge": {"$ref": "context-packet-v4.schema.json#/$defs/budget_usage"},
        "collaboration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit_bytes", "used_bytes", "remaining_bytes"],
          "properties": {
            "limit_bytes": {"type": "integer", "minimum": 0},
            "used_bytes": {"type": "integer", "minimum": 0},
            "remaining_bytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
