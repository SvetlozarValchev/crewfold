{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:knowledge-list:v1",
  "title": "Crewfold bounded canonical knowledge list v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["revisions"],
  "properties": {
    "revisions": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "knowledge-revision.schema.json"}
    }
  }
}
