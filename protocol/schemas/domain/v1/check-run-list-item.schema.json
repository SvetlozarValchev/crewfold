{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-run-list-item:v1",
  "type":"object","additionalProperties":false,
  "required":["run","requirement_state"],
  "properties":{
    "run":{"$ref":"check-run.schema.json"},
    "outcome":{"enum":["passed","failed","timed_out","start_failed","unknown"]},
    "current_freshness":{"$ref":"check-result-freshness.schema.json"},
    "requirement_state":{"enum":["missing","running","verified","failed","stale","unknown"]}
  }
}
