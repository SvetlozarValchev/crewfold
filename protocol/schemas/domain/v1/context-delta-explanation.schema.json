{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-delta-explanation:v1",
  "title": "Crewfold context delta explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["delta_id", "run_id", "context_packet_id", "sequence", "from_event_sequence", "through_event_sequence", "change_kinds", "content_hash", "byte_size", "included", "excluded", "budget"],
  "properties": {
    "delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "context_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "parent_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "from_event_sequence": {"type": "integer", "minimum": 0},
    "through_event_sequence": {"type": "integer", "minimum": 0},
    "change_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"enum": ["message_received", "knowledge_accepted", "knowledge_withdrawn", "contradiction_opened", "contradiction_closed", "dependent_added", "dependent_updated", "participant_roster_updated"]}
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 16384},
    "included": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "context-packet-v3.schema.json#/$defs/selection"}},
    "excluded": {"type": "array", "maxItems": 0, "items": {"$ref": "context-packet-v4.schema.json#/$defs/exclusion"}},
    "budget": {"$ref": "context-delta.schema.json#/$defs/budget"}
  }
}
