{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-policy:v1",
  "type":"object","additionalProperties":false,
  "required":["workspace_id","project_id","repair_proposals_enabled","max_open_repair_proposals","revision","created_at","updated_at","created_by","updated_by"],
  "allOf":[
    {
      "if":{"properties":{"repair_proposals_enabled":{"const":true}},"required":["repair_proposals_enabled"]},
      "then":{"required":["repair_launch_profile_id","repair_launch_profile_revision"]},
      "else":{"not":{"anyOf":[{"required":["repair_launch_profile_id"]},{"required":["repair_launch_profile_revision"]}]}}
    }
  ],
  "properties":{
    "workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},
    "project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},
    "repair_proposals_enabled":{"type":"boolean"},
    "repair_launch_profile_id":{"type":"string","pattern":"^lprof_[0-9a-f]{32}$"},
    "repair_launch_profile_revision":{"type":"integer","minimum":1},
    "max_open_repair_proposals":{"type":"integer","minimum":1,"maximum":32},
    "revision":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","minLength":1},
    "updated_by":{"type":"string","minLength":1}
  },
  "dependentRequired":{
    "repair_launch_profile_id":["repair_launch_profile_revision"],
    "repair_launch_profile_revision":["repair_launch_profile_id"]
  }
}
