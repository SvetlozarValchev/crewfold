{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-refresh-result:v1",
  "title": "Crewfold context refresh result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "run_id", "context_packet_id", "state_revision", "scanned_from_event_sequence", "scanned_through_event_sequence", "chain", "event_sequence"],
  "properties": {
    "status": {"enum": ["created", "pending", "up_to_date", "rebase_required"]},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "context_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "state_revision": {"type": "integer", "minimum": 0},
    "scanned_from_event_sequence": {"type": "integer", "minimum": 0},
    "scanned_through_event_sequence": {"type": "integer", "minimum": 0},
    "chain": {"$ref": "context-delta-chain.schema.json"},
    "delta": {"$ref": "context-delta.schema.json"},
    "rebase_reason": {"enum": ["unsupported_packet", "base_contract_changed", "dependency_set_changed", "event_window_exceeded", "delta_limit_exceeded", "cumulative_limit_exceeded", "unsupported_event_type"]},
    "event_sequence": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "pending_chain": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "chain": {
          "type": "object",
          "required": ["pending_delta_id"],
          "properties": {"pending_sequence": {"minimum": 1}},
          "not": {"anyOf": [{"required": ["rebase_reason"]}, {"required": ["rebase_event_sequence"]}]}
        }
      }
    },
    "clear_chain": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "chain": {
          "type": "object",
          "properties": {"pending_sequence": {"const": 0}},
          "not": {"anyOf": [{"required": ["pending_delta_id"]}, {"required": ["rebase_reason"]}, {"required": ["rebase_event_sequence"]}]}
        }
      }
    },
    "rebase_union": {
      "type": "object",
      "required": ["rebase_reason", "chain"],
      "oneOf": [
        {
          "properties": {
            "rebase_reason": {"const": "unsupported_packet"},
            "event_sequence": {"const": 0},
            "chain": {
              "type": "object",
              "required": ["rebase_reason"],
              "properties": {"pending_sequence": {"const": 0}, "rebase_reason": {"const": "unsupported_packet"}},
              "not": {"anyOf": [{"required": ["pending_delta_id"]}, {"required": ["rebase_event_sequence"]}]}
            }
          }
        },
        {
          "properties": {
            "rebase_reason": {"const": "base_contract_changed"},
            "event_sequence": {"minimum": 1},
            "chain": {"$ref": "#/$defs/durable_rebase_base_contract_changed"}
          }
        },
        {
          "properties": {
            "rebase_reason": {"const": "dependency_set_changed"},
            "event_sequence": {"minimum": 1},
            "chain": {"$ref": "#/$defs/durable_rebase_dependency_set_changed"}
          }
        },
        {
          "properties": {
            "rebase_reason": {"const": "event_window_exceeded"},
            "event_sequence": {"minimum": 1},
            "chain": {"$ref": "#/$defs/durable_rebase_event_window_exceeded"}
          }
        },
        {
          "properties": {
            "rebase_reason": {"const": "delta_limit_exceeded"},
            "event_sequence": {"minimum": 1},
            "chain": {"$ref": "#/$defs/durable_rebase_delta_limit_exceeded"}
          }
        },
        {
          "properties": {
            "rebase_reason": {"const": "cumulative_limit_exceeded"},
            "event_sequence": {"minimum": 1},
            "chain": {"$ref": "#/$defs/durable_rebase_cumulative_limit_exceeded"}
          }
        },
        {
          "properties": {
            "rebase_reason": {"const": "unsupported_event_type"},
            "event_sequence": {"minimum": 1},
            "chain": {"$ref": "#/$defs/durable_rebase_unsupported_event_type"}
          }
        }
      ]
    },
    "durable_rebase_base_contract_changed": {"$ref": "#/$defs/durable_rebase", "properties": {"rebase_reason": {"const": "base_contract_changed"}}},
    "durable_rebase_dependency_set_changed": {"$ref": "#/$defs/durable_rebase", "properties": {"rebase_reason": {"const": "dependency_set_changed"}}},
    "durable_rebase_event_window_exceeded": {"$ref": "#/$defs/durable_rebase", "properties": {"rebase_reason": {"const": "event_window_exceeded"}}},
    "durable_rebase_delta_limit_exceeded": {"$ref": "#/$defs/durable_rebase", "properties": {"rebase_reason": {"const": "delta_limit_exceeded"}}},
    "durable_rebase_cumulative_limit_exceeded": {"$ref": "#/$defs/durable_rebase", "properties": {"rebase_reason": {"const": "cumulative_limit_exceeded"}}},
    "durable_rebase_unsupported_event_type": {"$ref": "#/$defs/durable_rebase", "properties": {"rebase_reason": {"const": "unsupported_event_type"}}},
    "durable_rebase": {
      "type": "object",
      "required": ["rebase_reason", "rebase_event_sequence"],
      "properties": {"pending_sequence": {"const": 0}},
      "not": {"required": ["pending_delta_id"]}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "created"}}}, "then": {"$ref": "#/$defs/pending_chain", "required": ["delta"], "not": {"required": ["rebase_reason"]}, "properties": {"event_sequence": {"minimum": 1}}}},
    {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"$ref": "#/$defs/pending_chain", "required": ["delta"], "not": {"required": ["rebase_reason"]}, "properties": {"event_sequence": {"const": 0}}}},
    {
      "if": {"properties": {"status": {"const": "rebase_required"}}},
      "then": {
        "$ref": "#/$defs/rebase_union",
        "required": ["rebase_reason"],
        "not": {"required": ["delta"]}
      }
    },
    {"if": {"properties": {"status": {"const": "up_to_date"}}}, "then": {"$ref": "#/$defs/clear_chain", "not": {"anyOf": [{"required": ["delta"]}, {"required": ["rebase_reason"]}]}, "properties": {"event_sequence": {"const": 0}}}}
  ]
}
