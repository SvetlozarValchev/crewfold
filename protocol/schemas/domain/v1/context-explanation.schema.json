{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-explanation:v1",
  "title": "Crewfold context selection explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "content_hash", "byte_size", "included", "excluded"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 32768},
    "included": {"type": "array", "items": {"$ref": "context-packet.schema.json#/$defs/selection"}},
    "excluded": {"type": "array", "items": {"$ref": "context-packet.schema.json#/$defs/exclusion"}}
  }
}
