{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:task-timeline:v1",
  "title": "Crewfold task timeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "runs", "entries"],
  "properties": {
    "task": {"$ref": "task.schema.json"},
    "runs": {"type": "array", "items": {"$ref": "run.schema.json"}},
    "entries": {"type": "array", "items": {"$ref": "run-timeline-entry.schema.json"}}
  }
}
