{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-check-watch-grant:v1",
  "title": "Crewfold packet-bound check-watch grant snapshot v1",
  "$comment": "JSON Schema validates the closed wire shape only. Crewfold semantic validation is mandatory for canonical operation ordering, definitions sorted by definition_id, and max_in_flight <= max_pending.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "grant_id", "grant_revision", "workspace_id", "project_id",
    "watcher_agent_id", "watcher_agent_revision", "operations", "definitions",
    "max_pending", "max_in_flight", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:domain:context-check-watch-grant:v1"},
    "grant_id": {"type": "string", "pattern": "^checkgrant_[0-9a-f]{32}$"},
    "grant_revision": {"type": "integer", "minimum": 1},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "watcher_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "watcher_agent_revision": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["run", "inspect", "propose_repair"]}
    },
    "definitions": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/definition"}
    },
    "max_pending": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 100},
    "expires_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "content_revision", "definition_sha256"],
      "properties": {
        "definition_id": {"type": "string", "pattern": "^checkdef_[0-9a-f]{32}$"},
        "content_revision": {"type": "integer", "minimum": 1},
        "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
