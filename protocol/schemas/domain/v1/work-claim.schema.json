{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:work-claim:v1",
  "title": "Crewfold work claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "task_id", "kind", "target", "mode", "conflict_policy", "status", "baseline_paths", "lease_expires_at", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^claim_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "kind": {"enum": ["path", "component", "operation"]},
    "target": {"type": "string", "minLength": 1, "maxLength": 512},
    "mode": {"enum": ["exclusive", "shared", "advisory"]},
    "conflict_policy": {"enum": ["notify", "deny_new", "pause_scheduling", "request_resolution"]},
    "status": {"enum": ["active", "expired", "released"]},
    "baseline_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}
  }
}
