{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:task:v1",
  "title": "Crewfold task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "title", "status", "priority", "budget", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 4096},
    "status": {"enum": ["ready", "assigned", "active", "blocked", "completed", "cancelled"]},
    "blocked_reason": {"type": "string", "maxLength": 1024},
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "budget": {"$ref": "budget.schema.json"},
    "assignment_id": {"type": "string", "pattern": "^asg_[0-9a-f]{32}$"},
    "assigned_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "assignment_lease_expires_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}
  }
}
