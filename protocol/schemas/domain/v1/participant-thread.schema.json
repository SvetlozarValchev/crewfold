{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:participant-thread:v1",
  "title": "Crewfold participant-bound collaboration thread v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["thread", "kind", "participant_revision", "participants"],
  "properties": {
    "thread": {"$ref": "message-thread.schema.json"},
    "kind": {"const": "participant_bound"},
    "participant_revision": {"type": "integer", "minimum": 1},
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"$ref": "thread-participant.schema.json"}
    }
  }
}
