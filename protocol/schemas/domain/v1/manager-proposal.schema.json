{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:manager-proposal:v1",
  "title": "Crewfold manager proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "objective_id", "objective_revision", "source_run_id", "source_agent_id", "grant_id", "grant_revision", "kind", "summary", "status", "as_of_event_sequence", "actions", "validation_issues", "content_sha256", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^mprop_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "objective_revision": {"type": "integer", "minimum": 1},
    "source_run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "source_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "grant_id": {"type": "string", "pattern": "^mgrgrant_[0-9a-f]{32}$"},
    "grant_revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["task_decomposition", "assignment", "review", "escalation"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "status": {"enum": ["pending", "invalid", "accepted", "rejected", "stale"]},
    "as_of_event_sequence": {"type": "integer", "minimum": 0},
    "actions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "manager-proposal-action.schema.json"}},
    "validation_issues": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/issue"}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_note": {"type": "string", "maxLength": 2048},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
    "decided_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}, "decided_by": {"type": "string", "minLength": 1}
  },
  "$defs": {"issue": {"type": "object", "additionalProperties": false, "required": ["code", "path", "message", "severity"], "properties": {"code": {"type": "string", "minLength": 1}, "path": {"type": "string"}, "message": {"type": "string", "minLength": 1}, "severity": {"enum": ["error", "warning"]}}}}
}
