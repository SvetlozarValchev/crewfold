{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:run-detail:v1",
  "title": "Crewfold run detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "task", "agent", "checkout", "timeline"],
  "properties": {
    "run": {"$ref": "run.schema.json"},
    "task": {"$ref": "task.schema.json"},
    "agent": {"$ref": "agent.schema.json"},
    "checkout": {"$ref": "checkout.schema.json"},
    "timeline": {"type": "array", "items": {"$ref": "run-timeline-entry.schema.json"}},
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "needs", "severity", "related_ids"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
        "needs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "severity": {"type": "string", "enum": ["", "blocking", "high", "medium", "low"]},
        "related_ids": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "handoff": {"$ref": "handoff.schema.json"}
  }
}
