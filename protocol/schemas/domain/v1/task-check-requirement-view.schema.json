{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:task-check-requirement-view:v1",
  "type":"object","additionalProperties":false,
  "required":["requirement","state"],
  "properties":{
    "requirement":{"$ref":"task-check-requirement.schema.json"},
    "state":{"enum":["missing","running","verified","failed","stale","unknown"]},
    "latest_check_run_id":{"type":"string","pattern":"^checkrun_[0-9a-f]{32}$"},
    "latest_result":{"$ref":"check-result.schema.json"},
    "current_freshness":{"$ref":"check-result-freshness.schema.json"}
  }
}
