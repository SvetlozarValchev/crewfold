{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:curator-queue:v1",
  "title": "Crewfold deterministic curator proposal queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "rule"],
  "properties": {
    "rule": {"$ref": "curator-rule.schema.json"},
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/entry"}
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Opaque unpadded base64url cursor for the next deterministic page."
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "eligibility", "eligibility_reason", "rule_enabled"],
      "properties": {
        "revision": {"$ref": "knowledge-revision.schema.json"},
        "eligibility": {"enum": ["safe_auto_accept", "manual_review"]},
        "eligibility_reason": {
          "enum": ["accepted_meeting_resolution_copy", "rule_disabled", "not_curator_derived", "derivation_mismatch"]
        },
        "rule_enabled": {"type": "boolean"},
        "derivation": {"$ref": "curator-derivation.schema.json"}
      }
    }
  }
}
