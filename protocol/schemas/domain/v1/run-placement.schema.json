{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:run-placement:v1",
  "title": "Crewfold run placement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "agent_id", "checkout_id", "checkout_path", "write_mode", "runtime", "provider", "reasons"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "checkout_path": {"type": "string", "minLength": 1},
    "write_mode": {"enum": ["exclusive", "claimed", "shared"]},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  }
}
