{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-job:v1",
  "type":"object","additionalProperties":false,
  "required":["id","check_run_id","status","available_at","attempts","created_at","updated_at"],
  "properties":{
    "id":{"type":"string","pattern":"^checkjob_[0-9a-f]{32}$"},
    "check_run_id":{"type":"string","pattern":"^checkrun_[0-9a-f]{32}$"},
    "status":{"enum":["pending","leased","complete"]},
    "available_at":{"type":"string","format":"date-time"},
    "lease_expires_at":{"type":"string","format":"date-time"},
    "attempts":{"type":"integer","minimum":0},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
