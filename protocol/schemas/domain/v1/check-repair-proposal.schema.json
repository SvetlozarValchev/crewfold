{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-repair-proposal:v1",
  "type":"object","additionalProperties":false,
  "$comment":"source_run_id, source_agent_id/revision, and source_grant_id/revision are an exact authenticated current-packet provenance tuple; created_by and updated_by equal agent:<source_agent_id>.",
  "required":["id","workspace_id","project_id","objective_id","objective_revision","task_id","task_revision","requirement_id","requirement_revision","check_result_id","freshness_revision","source_repository_id","source_checkout_id","source_head_commit","policy_revision","repair_launch_profile_id","repair_launch_profile_revision","source_run_id","source_agent_id","source_agent_revision","source_grant_id","source_grant_revision","rationale","repair_task_title","repair_task_description","repair_task_priority","repair_task_budget","status","revision","created_at","updated_at","created_by","updated_by"],
  "properties":{
    "id":{"type":"string","pattern":"^checkrepair_[0-9a-f]{32}$"},
    "workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},
    "project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},
    "objective_id":{"type":"string","pattern":"^obj_[0-9a-f]{32}$"},
    "objective_revision":{"type":"integer","minimum":1},
    "task_id":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},
    "task_revision":{"type":"integer","minimum":1},
    "requirement_id":{"type":"string","pattern":"^checkreq_[0-9a-f]{32}$"},
    "requirement_revision":{"type":"integer","minimum":1},
    "check_result_id":{"type":"string","pattern":"^checkresult_[0-9a-f]{32}$"},
    "freshness_revision":{"type":"integer","minimum":1},
    "source_repository_id":{"type":"string","pattern":"^repo_[0-9a-f]{32}$"},
    "source_checkout_id":{"type":"string","pattern":"^co_[0-9a-f]{32}$"},
    "source_head_commit":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "policy_revision":{"type":"integer","minimum":1},
    "repair_launch_profile_id":{"type":"string","pattern":"^lprof_[0-9a-f]{32}$"},
    "repair_launch_profile_revision":{"type":"integer","minimum":1},
    "source_run_id":{"type":"string","pattern":"^run_[0-9a-f]{32}$"},
    "source_agent_id":{"type":"string","pattern":"^agent_[0-9a-f]{32}$"},
    "source_agent_revision":{"type":"integer","minimum":1},
    "source_grant_id":{"type":"string","pattern":"^checkgrant_[0-9a-f]{32}$"},
    "source_grant_revision":{"type":"integer","minimum":1},
    "rationale":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^\\u0000]*$","description":"Canonical UTF-8 without NUL, bounded to 4096 encoded bytes."},
    "repair_task_title":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000]*$","description":"Canonical UTF-8 without NUL, bounded to 256 encoded bytes."},
    "repair_task_description":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^\\u0000]*$","description":"Canonical UTF-8 without NUL, bounded to 4096 encoded bytes."},
    "repair_task_priority":{"type":"integer","minimum":0,"maximum":1000},
    "repair_task_budget":{"$ref":"budget.schema.json"},
    "status":{"enum":["pending","accepted","rejected","stale"]},
    "revision":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","pattern":"^agent:agent_[0-9a-f]{32}$"},
    "updated_by":{"type":"string","pattern":"^agent:agent_[0-9a-f]{32}$"}
  }
}
