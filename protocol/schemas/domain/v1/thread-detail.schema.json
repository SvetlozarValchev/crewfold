{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:thread-detail:v1",
  "title": "Crewfold message thread detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["thread", "messages", "recipients"],
  "properties": {
    "thread": {"$ref": "message-thread.schema.json"},
    "messages": {"type": "array", "items": {"$ref": "message.schema.json"}},
    "recipients": {"type": "array", "items": {"$ref": "message-delivery.schema.json"}}
  }
}
