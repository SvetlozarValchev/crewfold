{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:deliverable-commitment:v1",
  "title": "Crewfold deliverable commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "objective_id", "task_id", "key", "title", "acceptance_criteria", "content_sha256", "created_at", "created_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^outcommit_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "key": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 4096},
    "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"const": "local-owner"}
  }
}
