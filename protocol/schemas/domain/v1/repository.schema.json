{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:repository:v1",
  "title": "Crewfold Git repository identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "fingerprint", "object_format", "root_commits", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^repo_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "fingerprint": {"type": "string", "pattern": "^git_[0-9a-f]{64}$"},
    "object_format": {"enum": ["sha1", "sha256"]},
    "root_commits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}
  }
}
