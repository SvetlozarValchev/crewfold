{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:thread-participant:v1",
  "title": "Crewfold participant thread binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "thread_id", "workspace_id", "agent_id", "agent_name", "task_id", "task_title", "project_id", "project_name", "assignment_id", "assignment_revision", "agent_revision", "task_revision", "ordinal", "status", "invited_at", "invited_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^participant_[0-9a-f]{32}$"},
    "thread_id": {"type": "string", "pattern": "^thread_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "agent_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "task_title": {"type": "string", "minLength": 1, "maxLength": 256},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "project_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "assignment_id": {"type": "string", "pattern": "^asg_[0-9a-f]{32}$"},
    "assignment_revision": {"type": "integer", "minimum": 1},
    "agent_revision": {"type": "integer", "minimum": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 8},
    "status": {"const": "active"},
    "invited_at": {"type": "string", "format": "date-time"},
    "invited_by": {"type": "string", "minLength": 1}
  }
}
