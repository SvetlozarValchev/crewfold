{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:curator-process:v1",
  "title": "Crewfold bounded curator processing result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates_scanned", "derived", "accepted", "skipped"],
  "properties": {
    "candidates_scanned": {"type": "integer", "minimum": 0, "maximum": 100},
    "derived": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "curator-derivation.schema.json"}
    },
    "accepted": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "curator-auto-acceptance.schema.json"}
    },
    "skipped": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/skip"}
    }
  },
  "$defs": {
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "source_revision", "reason"],
      "properties": {
        "source_type": {"const": "meeting_proposal"},
        "source_id": {"type": "string", "pattern": "^proposal_[0-9a-f]{32}$"},
        "source_revision": {"type": "integer", "minimum": 1},
        "reason": {"enum": ["agenda_not_exact_safe_copy", "summary_not_exact_safe_copy"]}
      }
    }
  }
}
