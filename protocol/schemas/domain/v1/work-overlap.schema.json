{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:work-overlap:v1",
  "title": "Crewfold work overlap v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "claim_ids", "task_ids", "kind", "witness", "severity", "policy_response", "scheduling_paused", "resolution_required", "status", "explanation", "detected_at", "revision"],
  "properties": {
    "id": {"type": "string", "pattern": "^overlap_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "claim_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^claim_[0-9a-f]{32}$"}, "uniqueItems": true},
    "task_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}, "uniqueItems": true},
    "kind": {"enum": ["path", "component", "operation"]},
    "witness": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "policy_response": {"enum": ["notify", "deny_new", "pause_scheduling", "request_resolution"]},
    "scheduling_paused": {"type": "boolean"},
    "resolution_required": {"type": "boolean"},
    "status": {"enum": ["open", "resolved"]},
    "explanation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "detected_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "resolution_reason": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1}
  }
}
