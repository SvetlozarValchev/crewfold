{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:captured-log:v1",
  "title": "Crewfold captured log v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "captured_bytes", "omitted_bytes", "truncated"],
  "properties": {
    "text": {"type": "string"},
    "captured_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "omitted_bytes": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"}
  }
}
