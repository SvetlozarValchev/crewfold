{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-manager-grant:v1",
  "title": "Crewfold packet-bound manager grant snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "owner_executive", "invocation_launch_profile_id", "invocation_launch_profile_revision", "grant_id", "grant_revision", "workspace_id", "project_id", "objective_id", "objective_revision",
    "manager_agent_id", "manager_agent_revision", "manager_task_id", "manager_task_revision", "allowed_proposal_kinds",
    "launch_profiles", "allowed_claim_kinds", "max_open_proposals", "max_actions", "max_tasks", "max_dependencies",
    "max_claim_requirements", "budget"
  ],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:domain:context-manager-grant:v1"},
    "owner_executive": {"type": "boolean"},
    "invocation_launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"},
    "invocation_launch_profile_revision": {"type": "integer", "minimum": 1},
    "grant_id": {"type": "string", "pattern": "^mgrgrant_[0-9a-f]{32}$"},
    "grant_revision": {"type": "integer", "minimum": 1},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "objective_revision": {"type": "integer", "minimum": 1},
    "manager_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "manager_agent_revision": {"type": "integer", "minimum": 1},
    "manager_task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "manager_task_revision": {"type": "integer", "minimum": 1},
    "allowed_proposal_kinds": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["assignment", "escalation", "review", "task_decomposition"]}
    },
    "launch_profiles": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/launch_profile"}
    },
    "allowed_claim_kinds": {
      "type": "array", "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["path", "component", "operation"]}
    },
    "max_open_proposals": {"type": "integer", "minimum": 1, "maximum": 32},
    "max_actions": {"type": "integer", "minimum": 1, "maximum": 32},
    "max_tasks": {"type": "integer", "minimum": 1, "maximum": 16},
    "max_dependencies": {"type": "integer", "minimum": 1, "maximum": 32},
    "max_claim_requirements": {"type": "integer", "minimum": 1, "maximum": 32},
    "budget": {"$ref": "budget.schema.json"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "launch_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_profile_id", "revision", "agent_id", "agent_revision"],
      "properties": {
        "launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"},
        "revision": {"type": "integer", "minimum": 1},
        "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "agent_revision": {"type": "integer", "minimum": 1}
      }
    }
  }
}
