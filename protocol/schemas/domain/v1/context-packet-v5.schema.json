{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-packet:v5",
  "title": "Crewfold immutable manager context packet v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "workspace_id", "project_id", "task_id", "agent_id", "checkout_id",
    "role", "task", "checkout", "dependencies", "dependents", "dependent_task_count", "inbox", "participant_threads",
    "requested_knowledge_revision_ids", "accepted_knowledge", "policy", "live_context", "management_grant",
    "reporting", "included", "excluded", "budget", "as_of_event_sequence", "content_hash", "byte_size", "created_at", "created_by"
  ],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:domain:context-packet:v5"},
    "id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "role": {"$ref": "context-packet-v3.schema.json#/$defs/role"},
    "task": {"$ref": "context-packet-v4.schema.json#/$defs/task"},
    "checkout": {"$ref": "context-packet-v3.schema.json#/$defs/checkout"},
    "dependencies": {"type": "array", "maxItems": 32, "items": {"$ref": "context-packet-v3.schema.json#/$defs/dependency"}},
    "dependents": {"type": "array", "maxItems": 32, "items": {"$ref": "context-packet-v3.schema.json#/$defs/dependency"}},
    "dependent_task_count": {"type": "integer", "minimum": 0},
    "inbox": {"$ref": "context-packet-v3.schema.json#/$defs/inbox"},
    "participant_threads": {"type": "array", "maxItems": 8, "items": {"$ref": "participant-thread.schema.json"}},
    "requested_knowledge_revision_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"}},
    "accepted_knowledge": {"type": "array", "maxItems": 16, "items": {"$ref": "knowledge-revision.schema.json"}},
    "policy": {"$ref": "#/$defs/policy"},
    "live_context": {"$ref": "live-context-policy.schema.json"},
    "management_grant": {"$ref": "context-manager-grant.schema.json"},
    "reporting": {"$ref": "context-packet-v3.schema.json#/$defs/reporting"},
    "included": {"type": "array", "minItems": 4, "maxItems": 128, "items": {"$ref": "context-packet-v3.schema.json#/$defs/selection"}},
    "excluded": {"type": "array", "maxItems": 128, "items": {"$ref": "context-packet-v4.schema.json#/$defs/exclusion"}},
    "budget": {"$ref": "context-packet-v4.schema.json#/$defs/budget"},
    "as_of_event_sequence": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 32768},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"const": "local-owner"}
  },
  "allOf": [
    {
      "if": {"properties": {"management_grant": {"properties": {"allowed_proposal_kinds": {"contains": {"const": "assignment"}}}}}},
      "then": {"properties": {"policy": {"properties": {"allowed_tools": {"contains": {"const": "crewfold_propose_assignment"}}}}}},
      "else": {"properties": {"policy": {"properties": {"allowed_tools": {"not": {"contains": {"const": "crewfold_propose_assignment"}}}}}}}
    },
    {
      "if": {"properties": {"management_grant": {"properties": {"allowed_proposal_kinds": {"contains": {"const": "escalation"}}}}}},
      "then": {"properties": {"policy": {"properties": {"allowed_tools": {"contains": {"const": "crewfold_propose_escalation"}}}}}},
      "else": {"properties": {"policy": {"properties": {"allowed_tools": {"not": {"contains": {"const": "crewfold_propose_escalation"}}}}}}}
    },
    {
      "if": {"properties": {"management_grant": {"properties": {"allowed_proposal_kinds": {"contains": {"const": "review"}}}}}},
      "then": {"properties": {"policy": {"properties": {"allowed_tools": {"contains": {"const": "crewfold_propose_review"}}}}}},
      "else": {"properties": {"policy": {"properties": {"allowed_tools": {"not": {"contains": {"const": "crewfold_propose_review"}}}}}}}
    },
    {
      "if": {"properties": {"management_grant": {"properties": {"allowed_proposal_kinds": {"contains": {"const": "task_decomposition"}}}}}},
      "then": {"properties": {"policy": {"properties": {"allowed_tools": {"contains": {"const": "crewfold_propose_tasks"}}}}}},
      "else": {"properties": {"policy": {"properties": {"allowed_tools": {"not": {"contains": {"const": "crewfold_propose_tasks"}}}}}}}
    }
  ],
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tools", "denied_operations", "approval_required"],
      "properties": {
        "allowed_tools": {
          "type": "array", "minItems": 15, "maxItems": 18, "uniqueItems": true,
          "prefixItems": [
            {"const": "crewfold_acknowledge_context_delta"}, {"const": "crewfold_acknowledge_message"},
            {"const": "crewfold_get_briefing"}, {"const": "crewfold_get_context_delta"}, {"const": "crewfold_get_status"},
            {"const": "crewfold_list_inbox"}, {"const": "crewfold_propose_knowledge"}, {"const": "crewfold_propose_completion"},
            {"const": "crewfold_publish_artifact"}, {"const": "crewfold_read_message"}, {"const": "crewfold_report_blocked"},
            {"const": "crewfold_report_contradiction"}, {"const": "crewfold_report_progress"}, {"const": "crewfold_send_message"}
          ],
          "items": {"enum": ["crewfold_propose_assignment", "crewfold_propose_escalation", "crewfold_propose_review", "crewfold_propose_tasks"]}
        },
        "denied_operations": {"const": ["change another run or task", "push or merge source", "deploy", "message a person or broadcast", "read unscoped context"]},
        "approval_required": {"const": ["shared repository mutation", "external side effect", "destructive operation"]}
      }
    }
  }
}
