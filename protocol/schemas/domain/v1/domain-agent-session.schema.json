{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:domain-agent-session:v1",
  "title": "Crewfold domain agent session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "agent_id", "state", "has_conversation", "epoch", "revision"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "provider": {"type": "string", "pattern": "^[a-z0-9._-]{1,64}$"},
    "state": {"enum": ["unbound", "ready", "detached", "archived"]},
    "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
    "has_conversation": {"type": "boolean"},
    "epoch": {"type": "integer", "minimum": 0},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "unbound"}}}, "then": {"properties": {"has_conversation": {"const": false}, "epoch": {"const": 0}, "revision": {"const": 0}}}},
    {"if": {"properties": {"state": {"enum": ["ready", "detached", "archived"]}}}, "then": {"required": ["provider", "cwd", "created_at", "updated_at"], "properties": {"has_conversation": {"const": true}, "epoch": {"minimum": 1}, "revision": {"minimum": 1}}}}
  ]
}
