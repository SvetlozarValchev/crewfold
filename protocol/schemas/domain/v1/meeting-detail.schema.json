{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:meeting-detail:v1",
  "title": "Crewfold structured meeting detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meeting", "frozen_input", "participants", "contributions", "actions"],
  "properties": {
    "meeting": {"$ref": "#/$defs/meeting"},
    "frozen_input": {"$ref": "#/$defs/frozenInput"},
    "participants": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/participant"}},
    "contributions": {"type": "array", "items": {"$ref": "#/$defs/contribution"}},
    "proposal": {"$ref": "#/$defs/proposal"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "project_id", "overlap_id", "agenda", "facilitator_agent_id", "policy", "allowed_actions", "status", "frozen_input_hash", "deadline_at", "revision", "created_at", "updated_at", "created_by", "updated_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^meet_[0-9a-f]{32}$"},
        "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
        "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
        "overlap_id": {"type": "string", "pattern": "^overlap_[0-9a-f]{32}$"},
        "agenda": {"type": "string", "minLength": 1},
        "facilitator_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "policy": {"enum": ["owner_decision", "named_reviewer", "manager_bounded"]},
        "reviewer_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/actionType"}},
        "status": {"enum": ["gathering_positions", "facilitator_pending", "awaiting_approval", "awaiting_reviewer", "concluded", "stalled", "cancelled"]},
        "frozen_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deadline_at": {"type": "string", "format": "date-time"},
        "stalled_reason": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "minLength": 1},
        "updated_by": {"type": "string", "minLength": 1}
      }
    },
    "frozenInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlap", "claims", "tasks", "agents", "event_sequence", "frozen_at"],
      "properties": {
        "overlap": {"$ref": "work-overlap.schema.json"},
        "claims": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "work-claim.schema.json"}},
        "tasks": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "task.schema.json"}},
        "agents": {"type": "array", "minItems": 3, "items": {"$ref": "agent.schema.json"}},
        "event_sequence": {"type": "integer", "minimum": 0},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_id", "agent_id", "ordinal", "status"],
      "properties": {
        "meeting_id": {"type": "string", "pattern": "^meet_[0-9a-f]{32}$"},
        "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"enum": ["pending", "submitted", "missing"]}
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meeting_id", "agent_id", "round", "summary", "evidence", "submitted_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^contrib_[0-9a-f]{32}$"},
        "meeting_id": {"type": "string", "pattern": "^meet_[0-9a-f]{32}$"},
        "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "round": {"enum": ["position", "review"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "submitted_at": {"type": "string", "format": "date-time"}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meeting_id", "proposed_by", "summary", "status", "revision", "proposed_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^proposal_[0-9a-f]{32}$"},
        "meeting_id": {"type": "string", "pattern": "^meet_[0-9a-f]{32}$"},
        "proposed_by": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["proposed", "accepted", "rejected"]},
        "revision": {"type": "integer", "minimum": 1},
        "proposed_at": {"type": "string", "format": "date-time"},
        "decided_at": {"type": "string", "format": "date-time"},
        "decision_note": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proposal_id", "ordinal", "type", "payload", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^action_[0-9a-f]{32}$"},
        "proposal_id": {"type": "string", "pattern": "^proposal_[0-9a-f]{32}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "type": {"$ref": "#/$defs/actionType"},
        "payload": {"type": "object"},
        "status": {"enum": ["pending", "applied", "failed"]},
        "result_entity_id": {"type": "string", "minLength": 1},
        "diagnostic": {"type": "string", "minLength": 1},
        "applied_at": {"type": "string", "format": "date-time"}
      }
    },
    "actionType": {"enum": ["sequence", "split", "reassign", "designate_role", "cancel"]}
  }
}
