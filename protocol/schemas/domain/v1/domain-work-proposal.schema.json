{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:domain-work-proposal:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "source_agent_id", "source_thread_id", "staffing_grant_id", "staffing_grant_revision", "summary", "as_of_event_sequence", "content", "content_sha256", "status", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^workprop_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "source_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "source_thread_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "staffing_grant_id": {"type": "string", "pattern": "^staffgrant_[0-9a-f]{32}$"},
    "staffing_grant_revision": {"type": "integer", "minimum": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "as_of_event_sequence": {"type": "integer", "minimum": 0},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_title", "objective_budget", "primary_checkout_id", "primary_checkout_revision", "reference_checkout_ids", "agents", "tasks"],
      "properties": {
        "objective_title": {"type": "string", "minLength": 1, "maxLength": 256},
        "objective_budget": {"$ref": "budget.schema.json"},
        "primary_checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
        "primary_checkout_revision": {"type": "integer", "minimum": 1},
        "reference_checkout_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"}},
        "agents": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "budget"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
              "existing_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
              "existing_membership_revision": {"type": "integer", "minimum": 1},
              "existing_launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"},
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
              "role": {"type": "string", "minLength": 1, "maxLength": 128},
              "parent_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
              "operating_charter": {"type": "string", "minLength": 1, "maxLength": 8192},
              "delegation_policy": {"enum": ["hands_on", "adaptive", "delegation_first"]},
              "provider": {"type": "string", "minLength": 1, "maxLength": 128},
              "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
              "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
              "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
              "budget": {"$ref": "budget.schema.json"}
            },
            "oneOf": [
              {"required": ["existing_agent_id", "existing_membership_revision", "existing_launch_profile_id"]},
              {"required": ["name", "role", "operating_charter", "delegation_policy", "provider", "runtime", "max_concurrency", "task_class"]}
            ]
          }
        },
        "tasks": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "title", "description", "task_class", "priority", "budget", "assignee_key", "depends_on", "dependency_delivery"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
              "title": {"type": "string", "minLength": 1, "maxLength": 256},
              "description": {"type": "string", "maxLength": 4096},
              "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
              "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
              "budget": {"$ref": "budget.schema.json"},
              "assignee_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
              "depends_on": {"type": "array", "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}},
              "dependency_delivery": {"type": "object", "maxProperties": 15, "additionalProperties": {"enum": ["completion", "handoff", "handoff_with_evidence"]}}
            }
          }
        }
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pending", "accepted", "rejected", "stale"]},
    "decision_note": {"type": "string", "minLength": 1, "maxLength": 2048},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "decided_by": {"type": "string", "minLength": 1}
  }
}
