{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:crewfold:schema:domain:managed-service-definition:v1",
  "type":"object","additionalProperties":false,
  "required":["id","workspace_id","project_id","checkout_id","name","description","executable","arguments","working_directory","environment","profile","profile_revision","network_mode","health","restart_policy","maximum_restarts","restart_cooldown_millis","stop_signal","stop_grace_millis","output_byte_limit","capacity_class","content_revision","content_sha256","status","revision","created_at","updated_at","created_by","updated_by"],
  "properties":{
    "id":{"type":"string","pattern":"^svcdef_[0-9a-f]{32}$"},"workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},"project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},"workstream_id":{"type":"string","pattern":"^obj_[0-9a-f]{32}$"},"checkout_id":{"type":"string","pattern":"^co_[0-9a-f]{32}$"},
    "name":{"type":"string","minLength":1,"maxLength":128},"description":{"type":"string","minLength":1,"maxLength":1024},"executable":{"type":"string","minLength":1,"maxLength":4096},"arguments":{"type":"array","maxItems":64,"items":{"type":"string","maxLength":4096,"pattern":"^[^\\x00]*$"}},"working_directory":{"type":"string","minLength":1,"maxLength":4096},"environment":{"type":"array","maxItems":64,"items":{"$ref":"managed-service-environment-variable.schema.json"}},
    "profile":{"type":"string","minLength":1,"maxLength":64},"profile_revision":{"type":"integer","minimum":1},"network_mode":{"enum":["none","loopback"]},"health":{"$ref":"managed-service-health.schema.json"},"restart_policy":{"enum":["never","on_failure","on_daemon_restart"]},"maximum_restarts":{"type":"integer","minimum":0,"maximum":20},"restart_cooldown_millis":{"type":"integer","minimum":0,"maximum":60000},"stop_signal":{"const":"term"},"stop_grace_millis":{"type":"integer","minimum":100,"maximum":60000},"output_byte_limit":{"type":"integer","minimum":4096,"maximum":1048576},"capacity_class":{"const":"local_development"},
    "content_revision":{"type":"integer","minimum":1},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"enum":["active","retired"]},"revision":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","minLength":1},"updated_by":{"type":"string","minLength":1}
  }
}
