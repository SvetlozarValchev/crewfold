{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:run-artifact:v1",
  "title": "Crewfold run artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "name", "media_type", "content_hash", "byte_size", "idempotency_key", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 0, "maximum": 32768},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
