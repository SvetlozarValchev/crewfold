{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:task-dependency:v1",
  "title": "Crewfold task dependency v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "depends_on_task_id", "created_at", "created_by"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "depends_on_task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1}
  }
}
