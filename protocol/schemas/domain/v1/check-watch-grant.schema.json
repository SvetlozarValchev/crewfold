{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-watch-grant:v1",
  "$comment":"Crewfold semantic validation additionally requires canonical operation order, definitions sorted uniquely by definition_id, and max_in_flight <= max_pending.",
  "type":"object","additionalProperties":false,
  "required":["id","workspace_id","project_id","agent_id","agent_revision","operations","definitions","max_pending","max_in_flight","content_sha256","status","revision","created_at","updated_at","created_by","updated_by"],
  "properties":{
    "id":{"type":"string","pattern":"^checkgrant_[0-9a-f]{32}$"},
    "workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},
    "project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},
    "agent_id":{"type":"string","pattern":"^agent_[0-9a-f]{32}$"},
    "agent_revision":{"type":"integer","minimum":1},
    "operations":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["run","inspect","propose_repair"]}},
    "definitions":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/definition"}},
    "max_pending":{"type":"integer","minimum":1,"maximum":100},
    "max_in_flight":{"type":"integer","minimum":1,"maximum":100},
    "expires_at":{"type":"string","format":"date-time"},
    "content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"enum":["active","revoked","expired"]},
    "revision":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","minLength":1},
    "updated_by":{"type":"string","minLength":1}
  },
  "$defs":{"definition":{"type":"object","additionalProperties":false,"required":["definition_id","content_revision","definition_sha256"],"properties":{
    "definition_id":{"type":"string","pattern":"^checkdef_[0-9a-f]{32}$"},
    "content_revision":{"type":"integer","minimum":1},
    "definition_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }}}
}
