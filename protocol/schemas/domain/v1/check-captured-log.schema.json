{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-captured-log:v1",
  "type":"object","additionalProperties":false,
  "required":["kind","content","captured_bytes","omitted_bytes","truncated","content_sha256"],
  "allOf":[
    {
      "if":{"properties":{"truncated":{"const":true}},"required":["truncated"]},
      "then":{"properties":{"omitted_bytes":{"minimum":1}}},
      "else":{"properties":{"omitted_bytes":{"const":0}}}
    }
  ],
  "properties":{
    "kind":{"enum":["stdout","stderr","diagnostic"]},
    "content":{"type":"string","maxLength":1048576},
    "captured_bytes":{"type":"integer","minimum":0,"maximum":1048576},
    "omitted_bytes":{"type":"integer","minimum":0},
    "truncated":{"type":"boolean"},
    "content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
