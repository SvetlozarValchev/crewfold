{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:domain-agent-staffing-grant:v1",
  "title": "Crewfold domain agent staffing grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "manager_agent_id", "manager_membership_revision", "profiles", "task_classes", "max_descendants", "max_concurrency", "budget", "status", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^staffgrant_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "manager_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "manager_membership_revision": {"type": "integer", "minimum": 1},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "domain-agent-staffing-profile.schema.json"}},
    "task_classes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}},
    "max_descendants": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
    "budget": {"$ref": "budget.schema.json"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "revoked", "expired"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"const": "local-owner"},
    "updated_by": {"const": "local-owner"}
  }
}
