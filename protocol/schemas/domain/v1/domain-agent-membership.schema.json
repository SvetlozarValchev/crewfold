{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:domain-agent-membership:v1",
  "title": "Crewfold domain agent membership v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "agent_id", "preferred_entry", "status", "revision", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "parent_agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "workstream_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "preferred_entry": {"type": "boolean"},
    "status": {"enum": ["active", "retired"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"const": "local-owner"},
    "updated_by": {"const": "local-owner"}
  }
}
