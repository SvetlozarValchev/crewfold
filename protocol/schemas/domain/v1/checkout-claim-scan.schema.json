{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:checkout-claim-scan:v1",
  "title": "Crewfold checkout claim scan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkout_id", "project_id", "dirty_paths", "observed_at", "observation_gap", "drifts_opened", "drifts_resolved"],
  "properties": {
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "dirty_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "observed_at": {"type": "string", "format": "date-time"},
    "previous_observed_at": {"type": "string", "format": "date-time"},
    "observation_gap": {"type": "boolean"},
    "drifts_opened": {"type": "integer", "minimum": 0},
    "drifts_resolved": {"type": "integer", "minimum": 0}
  }
}
