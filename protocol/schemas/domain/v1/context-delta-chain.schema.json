{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-delta-chain:v1",
  "title": "Crewfold run context delta chain state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "context_packet_id", "base_event_sequence", "scanned_through_event_sequence", "latest_sequence", "pending_sequence", "last_acknowledged_sequence", "delta_count", "cumulative_byte_size", "revision"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "context_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "base_event_sequence": {"type": "integer", "minimum": 0},
    "scanned_through_event_sequence": {"type": "integer", "minimum": 0},
    "latest_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "latest_sequence": {"type": "integer", "minimum": 0},
    "pending_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "pending_sequence": {"type": "integer", "minimum": 0},
    "last_acknowledged_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "last_acknowledged_sequence": {"type": "integer", "minimum": 0},
    "delta_count": {"type": "integer", "minimum": 0},
    "cumulative_byte_size": {"type": "integer", "minimum": 0, "maximum": 65536},
    "rebase_reason": {"enum": ["base_contract_changed", "dependency_set_changed", "event_window_exceeded", "delta_limit_exceeded", "cumulative_limit_exceeded", "unsupported_event_type"]},
    "rebase_event_sequence": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"latest_sequence": {"const": 0}}}, "then": {"not": {"required": ["latest_delta_id"]}}, "else": {"required": ["latest_delta_id"]}},
    {"if": {"properties": {"pending_sequence": {"const": 0}}}, "then": {"not": {"required": ["pending_delta_id"]}}, "else": {"required": ["pending_delta_id"]}},
    {"if": {"properties": {"last_acknowledged_sequence": {"const": 0}}}, "then": {"not": {"required": ["last_acknowledged_delta_id"]}}, "else": {"required": ["last_acknowledged_delta_id"]}},
    {
      "oneOf": [
        {"not": {"anyOf": [{"required": ["rebase_reason"]}, {"required": ["rebase_event_sequence"]}]}},
        {"properties": {"pending_sequence": {"const": 0}, "rebase_reason": {"enum": ["base_contract_changed", "dependency_set_changed", "event_window_exceeded", "delta_limit_exceeded", "cumulative_limit_exceeded", "unsupported_event_type"]}}, "required": ["rebase_reason", "rebase_event_sequence"], "not": {"required": ["pending_delta_id"]}}
      ]
    }
  ]
}
