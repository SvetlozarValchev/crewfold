{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:run:v1",
  "title": "Crewfold run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "project_id", "task_id", "assignment_id", "agent_id", "checkout_id", "runtime", "provider", "scenario_name", "status", "step_cursor", "revision", "created_at", "updated_at", "created_by", "updated_by", "placement"],
  "properties": {
    "id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "assignment_id": {"type": "string", "pattern": "^asg_[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "context_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "scenario_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "status": {"enum": ["requested", "starting", "active", "blocked", "stopping", "stopped", "lost", "review", "completed", "start_failed", "failed"]},
    "step_cursor": {"type": "integer", "minimum": 0},
    "blocked_question": {"type": "string", "minLength": 1, "maxLength": 1024},
    "result_summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "failure_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "failure_message": {"type": "string", "minLength": 1, "maxLength": 1024},
    "stop_grace_millis": {"type": "integer", "minimum": 1, "maximum": 30000},
    "stop_forced": {"type": "boolean", "const": true},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1},
    "placement": {"$ref": "run-placement.schema.json"}
  }
}
