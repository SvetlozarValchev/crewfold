{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-result:v1",
  "type":"object","additionalProperties":false,
  "required":["id","check_run_id","requirement_id","requirement_revision","definition_id","definition_content_revision","outcome","forced","terminal_observation","created_at","created_by"],
  "properties":{
    "id":{"type":"string","pattern":"^checkresult_[0-9a-f]{32}$"},
    "check_run_id":{"type":"string","pattern":"^checkrun_[0-9a-f]{32}$"},
    "requirement_id":{"type":"string","pattern":"^checkreq_[0-9a-f]{32}$"},
    "requirement_revision":{"type":"integer","minimum":1},
    "definition_id":{"type":"string","pattern":"^checkdef_[0-9a-f]{32}$"},
    "definition_content_revision":{"type":"integer","minimum":1},
    "outcome":{"enum":["passed","failed","timed_out","start_failed","unknown"]},
    "exit_code":{"type":"integer"},
    "forced":{"type":"boolean"},
    "diagnostic_code":{"type":"string","maxLength":128},
    "diagnostic":{"type":"string","maxLength":4096},
    "terminal_observation":{"$ref":"check-git-observation.schema.json"},
    "created_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","minLength":1}
  }
}
