{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:domain:check-run:v1",
  "type":"object","additionalProperties":false,
  "required":["id","workspace_id","project_id","task_id","task_revision","requirement_id","requirement_revision","definition_id","definition_content_revision","definition_sha256","checkout_id","checkout_revision","repository_id","repository_object_format","checkout_path","checkout_write_mode","source","status","revision","created_at","updated_at","created_by","updated_by"],
  "allOf":[
    {
      "if":{"properties":{"source":{"properties":{"type":{"const":"agent_run"}},"required":["type"]}},"required":["source"]},
      "then":{"required":["source_max_in_flight"]},
      "else":{"not":{"required":["source_max_in_flight"]}}
    }
  ],
  "properties":{
    "id":{"type":"string","pattern":"^checkrun_[0-9a-f]{32}$"},
    "workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},
    "project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},
    "task_id":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},
    "task_revision":{"type":"integer","minimum":1},
    "requirement_id":{"type":"string","pattern":"^checkreq_[0-9a-f]{32}$"},
    "requirement_revision":{"type":"integer","minimum":1},
    "definition_id":{"type":"string","pattern":"^checkdef_[0-9a-f]{32}$"},
    "definition_content_revision":{"type":"integer","minimum":1},
    "definition_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "checkout_id":{"type":"string","pattern":"^co_[0-9a-f]{32}$"},
    "checkout_revision":{"type":"integer","minimum":1},
    "repository_id":{"type":"string","pattern":"^repo_[0-9a-f]{32}$"},
    "repository_object_format":{"enum":["sha1","sha256"]},
    "checkout_path":{"type":"string","minLength":1,"maxLength":4096},
    "checkout_write_mode":{"enum":["exclusive","claimed","shared","read_only"]},
    "source":{"$ref":"check-run-source.schema.json"},
    "source_max_in_flight":{"type":"integer","minimum":1,"maximum":100},
    "status":{"enum":["requested","starting","running","finished"]},
    "runtime_handle":{"type":"string","maxLength":4096},
    "revision":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "started_at":{"type":"string","format":"date-time"},
    "finished_at":{"type":"string","format":"date-time"},
    "created_by":{"type":"string","minLength":1},
    "updated_by":{"type":"string","minLength":1}
  }
}
