{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:live-context-policy:v1",
  "title": "Crewfold bounded live context policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "delivery", "ack_authority", "max_pending", "max_relevant_events", "per_delta_limit_bytes", "cumulative_delta_limit_bytes"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:domain:live-context-policy:v1"},
    "delivery": {"const": "explicit_pull"},
    "ack_authority": {"const": "bound_run"},
    "max_pending": {"const": 1},
    "max_relevant_events": {"const": 1000},
    "per_delta_limit_bytes": {"const": 16384},
    "cumulative_delta_limit_bytes": {"const": 65536}
  }
}
