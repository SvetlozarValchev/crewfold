{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:knowledge-index-status:v1",
  "title": "Crewfold derived knowledge retrieval index status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "generation", "source_event_sequence", "source_count"],
  "properties": {
    "status": {"enum": ["ok", "degraded"]},
    "generation": {"type": "integer", "minimum": 0},
    "built_at": {"type": "string", "format": "date-time"},
    "source_event_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Node-wide event-journal observation high-water mark captured with this projection snapshot; it is neither a retrieval-freshness test nor a workspace-scoped knowledge cursor."
    },
    "source_count": {"type": "integer", "minimum": 0},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnosis": {"enum": ["missing", "corrupt", "out_of_date", "content_mismatch", "unsupported"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
      "then": {
        "required": ["built_at", "source_digest"],
        "not": {"required": ["diagnosis"]}
      },
      "else": {"required": ["diagnosis"]}
    }
  ]
}
