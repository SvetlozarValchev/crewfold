{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:budget:v1",
  "title": "Crewfold budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["token_limit", "cost_cents", "time_seconds"],
  "properties": {
    "token_limit": {"type": "integer", "minimum": 0},
    "cost_cents": {"type": "integer", "minimum": 0},
    "time_seconds": {"type": "integer", "minimum": 0}
  }
}
