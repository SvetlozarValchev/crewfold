{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:context-delta-acknowledgement:v1",
  "title": "Crewfold context delta acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "context_packet_id", "delta_id", "sequence", "acknowledged_at", "acknowledged_by", "event_sequence"],
  "properties": {
    "id": {"type": "string", "pattern": "^cdack_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "context_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "acknowledged_at": {"type": "string", "format": "date-time"},
    "acknowledged_by": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "event_sequence": {"type": "integer", "minimum": 1}
  }
}
