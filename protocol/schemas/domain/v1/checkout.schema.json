{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:domain:checkout:v1",
  "title": "Crewfold checkout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "repository_id", "path", "write_mode", "revision", "availability", "checkout_kind", "dirty", "observed_at", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "repository_id": {"type": "string", "pattern": "^repo_[0-9a-f]{32}$"},
    "path": {"type": "string", "minLength": 1},
    "write_mode": {"enum": ["exclusive", "claimed", "shared", "read_only"]},
    "revision": {"type": "integer", "minimum": 1},
    "availability": {"enum": ["available", "unavailable"]},
    "checkout_kind": {"enum": ["standalone", "linked_worktree", "unknown"]},
    "branch": {"type": "string"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "dirty": {"type": "boolean"},
    "git_dir": {"type": "string"},
    "git_common_dir": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "diagnostic_code": {"type": "string"},
    "diagnostic": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}
  }
}
