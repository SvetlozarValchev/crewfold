{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:crewfold:schema:domain:manager-grant:v1","title":"Crewfold manager grant v1","type":"object","additionalProperties":false,
  "required":["id","workspace_id","project_id","objective_id","objective_revision","task_id","task_revision","agent_id","agent_revision","proposal_kinds","launch_profiles","allowed_claim_kinds","limits","content_sha256","status","revision","created_at","updated_at","created_by","updated_by"],
  "properties":{
    "id":{"type":"string","pattern":"^mgrgrant_[0-9a-f]{32}$"},"workspace_id":{"type":"string","pattern":"^ws_[0-9a-f]{32}$"},"project_id":{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},"objective_id":{"type":"string","pattern":"^obj_[0-9a-f]{32}$"},"objective_revision":{"type":"integer","minimum":1},"task_id":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},"task_revision":{"type":"integer","minimum":1},"agent_id":{"type":"string","pattern":"^agent_[0-9a-f]{32}$"},"agent_revision":{"type":"integer","minimum":1},
    "proposal_kinds":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"enum":["assignment","escalation","review","task_decomposition"]}},"launch_profiles":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/launch_profile"}},"allowed_claim_kinds":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"enum":["path","component","operation"]}},"limits":{"$ref":"#/$defs/limits"},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"expires_at":{"type":"string","format":"date-time"},"status":{"enum":["active","revoked","expired"]},"revision":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"created_by":{"const":"local-owner"},"updated_by":{"const":"local-owner"}
  },
  "$defs":{"limits":{"type":"object","additionalProperties":false,"required":["max_open_proposals","max_actions","max_tasks","max_dependencies","max_claim_requirements","budget"],"properties":{"max_open_proposals":{"type":"integer","minimum":1,"maximum":32},"max_actions":{"type":"integer","minimum":1,"maximum":32},"max_tasks":{"type":"integer","minimum":1,"maximum":16},"max_dependencies":{"type":"integer","minimum":1,"maximum":32},"max_claim_requirements":{"type":"integer","minimum":1,"maximum":32},"budget":{"$ref":"budget.schema.json"}}},"launch_profile":{"type":"object","additionalProperties":false,"required":["launch_profile_id","revision","agent_id","agent_revision"],"properties":{"launch_profile_id":{"type":"string","pattern":"^lprof_[0-9a-f]{32}$"},"revision":{"type":"integer","minimum":1},"agent_id":{"type":"string","pattern":"^agent_[0-9a-f]{32}$"},"agent_revision":{"type":"integer","minimum":1}}}}
