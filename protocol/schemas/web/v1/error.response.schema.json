{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:web:error:v1",
  "title": "Crewfold workbench error response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "error"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:web:error:v1"},
    "type": {"const": "error"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "host_mismatch",
            "origin_mismatch",
            "method_not_allowed",
            "invalid_content_type",
            "request_too_large",
            "invalid_request",
            "invalid_bootstrap",
            "session_unavailable",
            "unauthorized"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
