{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:web:owner-conversation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "conversations", "turns", "exchanges", "executive", "review"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:web:owner-conversation:v1"},
    "type": {"const": "owner_conversation"},
    "conversations": {"type": "array", "maxItems": 20, "items": {"$ref": "owner-turn-detail.schema.json#/properties/conversation"}},
    "turns": {"type": "array", "maxItems": 200, "items": {"$ref": "owner-turn-detail.schema.json"}},
    "exchanges": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/exchange"}},
    "executive": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "workspace_id", "project_id", "objective_id", "planning_task_id", "agent_id", "manager_grant_id", "launch_profile_id", "status", "revision", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^exec_[0-9a-f]{32}$"},
        "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
        "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
        "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
        "planning_task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
        "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "manager_grant_id": {"type": "string", "pattern": "^mgrgrant_[0-9a-f]{32}$"},
        "launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"},
        "status": {"enum": ["active", "retired"]},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "review": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["workspace_id", "project_id", "conversation_id", "status", "requested_event_sequence", "reviewed_event_sequence", "attempts", "available_at", "created_at", "updated_at"],
      "properties": {
        "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
        "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
        "conversation_id": {"type": "string", "pattern": "^conv_[0-9a-f]{32}$"},
        "status": {"enum": ["idle", "pending", "leased", "failed"]},
        "requested_event_sequence": {"type": "integer", "minimum": 1},
        "reviewed_event_sequence": {"type": "integer", "minimum": 0},
        "attempts": {"type": "integer", "minimum": 0},
        "available_at": {"type": "string", "format": "date-time"},
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "last_turn_id": {"type": "string", "pattern": "^turn_[0-9a-f]{32}$"},
        "last_error": {"type": "string", "minLength": 1, "maxLength": 2048},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "turn_id", "binding_id", "event_sequence", "status", "attempts", "available_at", "proposal_ids", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^execx_[0-9a-f]{32}$"},
        "turn_id": {"type": "string", "pattern": "^turn_[0-9a-f]{32}$"},
        "binding_id": {"type": "string", "pattern": "^exec_[0-9a-f]{32}$"},
        "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
        "event_sequence": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "leased", "running", "responded", "failed"]},
        "attempts": {"type": "integer", "minimum": 0},
        "available_at": {"type": "string", "format": "date-time"},
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "proposal_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^mprop_[0-9a-f]{32}$"}},
        "last_error": {"type": "string", "minLength": 1, "maxLength": 2048},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
