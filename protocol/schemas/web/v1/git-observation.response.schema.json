{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:web:git-observation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "project_id", "observations"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:web:git-observation:v1"},
    "type": {"const": "git_observation"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "observations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkout_id", "availability", "dirty", "dirty_paths", "omitted_paths", "truncated", "observed_at"],
        "properties": {
          "checkout_id": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
          "availability": {"enum": ["available", "unavailable"]},
          "branch": {"type": "string", "maxLength": 1024},
          "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
          "dirty": {"type": "boolean"},
          "dirty_paths": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 1024}},
          "omitted_paths": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"},
          "observed_at": {"type": "string", "format": "date-time"},
          "diagnostic_code": {"type": "string", "maxLength": 64},
          "diagnostic": {"type": "string", "maxLength": 1024}
        }
      }
    }
  }
}
