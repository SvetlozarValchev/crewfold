{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:web:onboarding-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository_path", "workspace", "project", "agent", "provider", "runtime", "write_mode"],
  "properties": {
    "repository_path": {"type": "string", "minLength": 2, "maxLength": 4096},
    "workspace": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "agent": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "write_mode": {"enum": ["exclusive", "claimed", "shared", "read_only"]}
  }
}
