{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:web:terminal-grant:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "run_id", "runtime", "websocket_path", "protocol", "expires_at"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:web:terminal-grant:v1"},
    "type": {"const": "terminal_grant"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "websocket_path": {"const": "terminal"},
    "protocol": {"type": "string", "pattern": "^crewfold-terminal\\.[0-9a-f]{64}$"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
