{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:web:workbench-session:v1",
  "title": "Crewfold workbench session response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "status", "api_base", "csrf_token", "expires_at"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:web:workbench-session:v1"},
    "type": {"const": "workbench_session"},
    "status": {"const": "authenticated"},
    "api_base": {"type": "string", "pattern": "^/api/v1/session/[0-9a-f]{64}$"},
    "csrf_token": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
