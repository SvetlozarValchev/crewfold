{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:portable:knowledge-import-receipt:v1",
  "title": "Crewfold portable knowledge import receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "bundle_id", "workspace_id", "project_id", "content_sha256", "rendering_sha256", "imported_at", "imported_by", "imported_by_type", "completed_event_sequence"],
  "properties": {
    "id": {"type": "string", "pattern": "^kimp_[0-9a-f]{32}$"},
    "bundle_id": {"type": "string", "pattern": "^kbun_[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rendering_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the deterministic knowledge.md Markdown rendering."},
    "imported_at": {"type": "string", "format": "date-time"},
    "imported_by": {"const": "local-owner"},
    "imported_by_type": {"const": "human"},
    "completed_event_sequence": {"type": "integer", "minimum": 1}
  }
}
