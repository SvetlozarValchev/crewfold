{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:fixture:fake-run-scenario:v1",
  "title": "Crewfold deterministic fake run scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "acceptance", "steps"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:fixture:fake-run-scenario:v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "start_failure": {"type": "string", "minLength": 1, "maxLength": 1024},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_evidence"],
      "properties": {
        "required_evidence": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["progress", "blocked", "completion"]},
          "message": {"type": "string", "maxLength": 1024},
          "evidence": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "handoff": {"type": "string", "maxLength": 4096},
          "wait_for_resume": {"type": "boolean"}
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 125},
        "step_delay_millis": {"type": "integer", "minimum": 0, "maximum": 5000},
        "timeout_millis": {"type": "integer", "minimum": 0, "maximum": 60000},
        "stdout_noise_bytes": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "stderr_noise_bytes": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "hang_after_steps": {"type": "boolean"},
        "ignore_termination": {"type": "boolean"},
        "cross_run_probe": {"type": "boolean"},
        "duplicate_report": {"type": "boolean"},
        "publish_artifact": {"type": "boolean"}
      }
    },
    "mailbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "send": {"$ref": "#/$defs/mailbox_message"},
        "wait_for_kind": {"$ref": "#/$defs/message_kind"},
        "reply": {"$ref": "#/$defs/mailbox_message"},
        "acknowledge_received": {"type": "boolean"},
        "require_inbox_summary": {"type": "boolean"},
        "denied_artifact_probe": {"type": "boolean"},
        "wait_timeout_millis": {"type": "integer", "minimum": 0, "maximum": 30000},
        "denied_recipient_probe": {"type": "string", "minLength": 1, "maxLength": 128},
        "oversized_recipient_probe": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal": {"$ref": "#/$defs/knowledge_proposal"},
        "probe_reserved_acceptance": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "required": ["probe_reserved_acceptance"],
            "properties": {"probe_reserved_acceptance": {"const": true}}
          },
          "then": {"required": ["proposal"]}
        }
      ]
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "report_received", "confirm_denied"],
      "properties": {
        "report": {"$ref": "#/$defs/contradiction_report"},
        "report_received": {"const": true},
        "confirm_denied": {"const": true}
      }
    }
  },
  "$defs": {
    "message_kind": {"enum": ["inform", "question", "request", "review_request", "handoff", "decision_notice", "risk", "conflict", "approval_request"]},
    "mailbox_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "recipient_agent": {"type": "string", "minLength": 1, "maxLength": 128},
        "thread_id": {"type": "string", "pattern": "^thread_[0-9a-f]{32}$"},
        "kind": {"$ref": "#/$defs/message_kind"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 160},
        "body": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "knowledge_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "body", "confidence", "verification_status", "freshness_policy"],
      "properties": {
        "type": {"enum": ["decision", "finding"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 160, "description": "The semantic fixture loader also enforces 1–160 encoded UTF-8 bytes, valid UTF-8, nonblank text, and no NUL."},
        "body": {"type": "string", "minLength": 1, "maxLength": 16384, "description": "The semantic fixture loader also enforces 1–16384 encoded UTF-8 bytes, valid UTF-8, nonblank text, and no NUL."},
        "confidence": {"enum": ["low", "medium", "high"]},
        "verification_status": {"enum": ["unverified", "supported", "verified"]},
        "freshness_policy": {"const": "until_superseded"}
      }
    },
    "contradiction_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_revision", "right_revision", "reason"],
      "properties": {
        "left_revision": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
        "right_revision": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "The semantic fixture loader enforces 1–2048 encoded UTF-8 bytes, nonblank text, and no NUL."}
      }
    }
  },
  "oneOf": [
    {"required": ["start_failure"], "properties": {"steps": {"maxItems": 0}}},
    {"not": {"required": ["start_failure"]}, "properties": {"steps": {"minItems": 1}}}
  ]
}
