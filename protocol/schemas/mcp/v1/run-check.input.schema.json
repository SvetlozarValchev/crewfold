{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:mcp:run-check-input:v1",
  "title": "Crewfold run granted check input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirement_id", "idempotency_key"],
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^checkreq_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
