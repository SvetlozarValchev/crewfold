{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:mcp:send-message-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipient_agent", "kind", "body", "artifact_ids", "idempotency_key"],
  "properties": {
    "recipient_agent": {"type": "string", "minLength": 1, "maxLength": 128},
    "thread_id": {"type": "string", "pattern": "^thread_[0-9a-f]{32}$"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 160},
    "kind": {"enum": ["inform", "question", "request", "review_request", "handoff", "decision_notice", "risk", "conflict", "approval_request"]},
    "body": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifact_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "reply_to_message_id": {"type": "string", "pattern": "^msg_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
