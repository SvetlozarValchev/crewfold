{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:mcp:get-status-output:v2",
  "title": "Crewfold run status structured output v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_status", "run_revision", "task_id", "task_status", "task_revision", "budget", "blocked_question", "context"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "run_status": {"enum": ["requested", "starting", "active", "blocked", "stopping", "stopped", "lost", "review", "completed", "start_failed", "failed"]},
    "run_revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "task_status": {"enum": ["ready", "assigned", "active", "blocked", "review", "changes_requested", "completed", "failed", "cancelled"]},
    "task_revision": {"type": "integer", "minimum": 1},
    "budget": {"$ref": "../../domain/v1/budget.schema.json"},
    "blocked_question": {"type": "string"},
    "context": {"$ref": "#/$defs/context"}
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_packet_id", "base_schema", "base_as_of_event_sequence", "state_revision",
        "scanned_through_event_sequence", "latest_delta_sequence", "acknowledged_delta_sequence",
        "delta_count", "cumulative_byte_size", "status", "rebase_required"
      ],
      "properties": {
        "base_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
        "base_schema": {"enum": ["urn:crewfold:schema:domain:context-packet:v1", "urn:crewfold:schema:domain:context-packet:v2", "urn:crewfold:schema:domain:context-packet:v3", "urn:crewfold:schema:domain:context-packet:v4"]},
        "base_as_of_event_sequence": {"type": "integer", "minimum": 0},
        "state_revision": {"type": "integer", "minimum": 0},
        "scanned_through_event_sequence": {"type": "integer", "minimum": 0},
        "latest_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
        "latest_delta_sequence": {"type": "integer", "minimum": 0},
        "pending_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
        "pending_delta_sequence": {"type": "integer", "minimum": 1},
        "acknowledged_delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
        "acknowledged_delta_sequence": {"type": "integer", "minimum": 0},
        "delta_count": {"type": "integer", "minimum": 0},
        "cumulative_byte_size": {"type": "integer", "minimum": 0, "maximum": 65536},
        "status": {"enum": ["pending", "none_pending", "rebase_required"]},
        "rebase_required": {"type": "boolean"},
        "rebase_reason": {"enum": ["unsupported_packet", "base_contract_changed", "dependency_set_changed", "event_window_exceeded", "delta_limit_exceeded", "cumulative_limit_exceeded", "unsupported_event_type"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"required": ["pending_delta_id", "pending_delta_sequence"], "not": {"required": ["rebase_reason"]}, "properties": {"rebase_required": {"const": false}}}},
        {"if": {"properties": {"status": {"const": "none_pending"}}}, "then": {"not": {"anyOf": [{"required": ["pending_delta_id"]}, {"required": ["pending_delta_sequence"]}, {"required": ["rebase_reason"]}]}, "properties": {"rebase_required": {"const": false}}}},
        {"if": {"properties": {"status": {"const": "rebase_required"}}}, "then": {"required": ["rebase_reason"], "not": {"anyOf": [{"required": ["pending_delta_id"]}, {"required": ["pending_delta_sequence"]}]}, "properties": {"rebase_required": {"const": true}}}}
      ]
    }
  }
}
