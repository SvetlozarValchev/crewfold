{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:mcp:acknowledge-context-delta-input:v1",
  "title": "Crewfold acknowledge context delta input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["delta_id", "expected_sequence", "idempotency_key"],
  "properties": {
    "delta_id": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"},
    "expected_sequence": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
