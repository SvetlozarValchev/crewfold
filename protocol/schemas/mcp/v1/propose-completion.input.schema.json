{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:mcp:propose-completion-input:v1",
  "title": "crewfold_propose_completion input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "handoff", "evidence_ids", "changed_paths", "checks", "remaining_risks", "unknowns", "idempotency_key"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "handoff": {"type": "string", "minLength": 1, "maxLength": 4096},
	"assessment": {"enum": ["pass", "block", "changes_requested"]},
    "evidence_ids": {"$ref": "#/$defs/items"},
    "changed_paths": {"$ref": "#/$defs/items"},
    "checks": {"$ref": "#/$defs/items"},
    "remaining_risks": {"$ref": "#/$defs/items"},
    "unknowns": {"$ref": "#/$defs/items"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {"items": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}}}
}
