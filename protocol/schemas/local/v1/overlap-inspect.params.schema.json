{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:overlap-inspect-params:v1",
  "title": "Crewfold local API overlap inspect parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "overlap"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "overlap": {"type": "string", "pattern": "^overlap_[0-9a-f]{32}$"}
  }
}
