{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-start-params:v1",
  "title": "Crewfold local API run start parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "task", "runtime", "provider", "scenario", "expected_task_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "checkout": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "context": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "scenario": {"$ref": "../../fixture/v1/fake-run-scenario.schema.json"},
    "expected_task_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
