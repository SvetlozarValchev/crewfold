{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-work-proposal-decision-result:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "decision"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:domain-work-proposal-decision-result:v1"},
    "type": {"const": "domain_work_proposal_decision"},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal", "effects", "event_sequence"],
      "properties": {
        "proposal": {"$ref": "../../domain/v1/domain-work-proposal.schema.json"},
        "effects": {
          "type": "array", "maxItems": 48,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["entity_type", "entity_id", "event_sequence"],
            "properties": {
              "task_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
              "entity_type": {"enum": ["objective", "task", "task_dependency", "scheduling_intent"]},
              "entity_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "event_sequence": {"type": "integer", "minimum": 1}
            }
          }
        },
        "event_sequence": {"type": "integer", "minimum": 1}
      }
    }
  }
}
