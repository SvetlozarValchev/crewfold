{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:context-refresh-params:v1",
  "title": "Crewfold local API context refresh parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "run", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "run": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
