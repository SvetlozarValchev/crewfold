{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:project-show-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
