{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:agent-create-params:v1",
  "title": "Crewfold local API agent create parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "name", "role", "provider", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "role": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
