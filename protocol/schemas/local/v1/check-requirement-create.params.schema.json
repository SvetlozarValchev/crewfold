{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-requirement-create-params:v1",
  "type":"object","additionalProperties":false,
  "required":["workspace","task","criterion_key","statement","definition","definition_content_revision","expected_task_revision","idempotency_key"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "task":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},
    "criterion_key":{"type":"string","minLength":1,"maxLength":128},
    "statement":{"type":"string","minLength":1,"maxLength":2048},
    "definition":{"type":"string","minLength":1,"maxLength":128},
    "definition_content_revision":{"type":"integer","minimum":1},
    "expected_task_revision":{"type":"integer","minimum":1},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":128}
  }
}
