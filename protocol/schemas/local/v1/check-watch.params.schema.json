{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-watch-params:v1",
  "type":"object","additionalProperties":false,"required":["workspace","project","idempotency_key"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "cursor":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","maxLength":4096},
    "limit":{"type":"integer","minimum":1,"maximum":100},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":128}
  }
}
