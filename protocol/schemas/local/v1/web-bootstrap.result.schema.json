{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:web-bootstrap-result:v1",
  "title": "Crewfold web bootstrap result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "url", "expires_at"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:web-bootstrap-result:v1"},
    "type": {"const": "web_bootstrap"},
    "url": {
      "type": "string",
      "minLength": 96,
      "maxLength": 160,
      "pattern": "^http://127\\.0\\.0\\.1:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/#bootstrap=[0-9a-f]{64}$"
    },
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
