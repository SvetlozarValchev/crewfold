{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:meeting-run-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "meeting", "expected_revision", "fixture", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1},
    "meeting": {"type": "string", "pattern": "^meet_[0-9a-f]{32}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions"],
      "properties": {
        "positions": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["agent_id", "summary"], "properties": {"agent_id": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1, "maxLength": 4096}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
        "proposal": {"$ref": "#/$defs/proposal"},
        "reviewer_approved": {"type": "boolean"},
        "reviewer_note": {"type": "string"},
        "pause_after_positions": {"type": "boolean"}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "proposal": {"type": "object", "additionalProperties": false, "required": ["summary", "actions"], "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 4096}, "actions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"enum": ["sequence", "split", "reassign", "designate_role", "cancel"]}, "payload": {"type": "object"}}}}}}
  }
}
