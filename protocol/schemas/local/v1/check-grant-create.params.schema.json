{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-grant-create-params:v1",
  "type":"object","additionalProperties":false,
  "required":["workspace","project","agent","expected_agent_revision","definitions","operations","max_pending","max_in_flight","idempotency_key"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "agent":{"type":"string","minLength":1,"maxLength":128},
    "expected_agent_revision":{"type":"integer","minimum":1},
    "definitions":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/definition"}},
    "operations":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["run","inspect","propose_repair"]}},
    "max_pending":{"type":"integer","minimum":1,"maximum":100},
    "max_in_flight":{"type":"integer","minimum":1,"maximum":100},
    "expires_at":{"type":"string","format":"date-time"},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":128}
  },
  "$defs":{"definition":{"type":"object","additionalProperties":false,"required":["definition","content_revision"],"properties":{
    "definition":{"type":"string","minLength":1,"maxLength":128},
    "content_revision":{"type":"integer","minimum":1}
  }}}
}
