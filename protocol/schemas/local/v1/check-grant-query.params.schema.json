{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-grant-query-params:v1",
  "type":"object","additionalProperties":false,"required":["workspace"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "grant":{"type":"string","pattern":"^checkgrant_[0-9a-f]{32}$"},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "agent":{"type":"string","minLength":1,"maxLength":128},
    "status":{"enum":["active","revoked","expired"]},
    "limit":{"type":"integer","minimum":1,"maximum":100}
  }
}
