{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:checkout-list-result:v1",
  "title": "Crewfold local API checkout list result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "project", "checkouts"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:checkout-list-result:v1"},
    "type": {"const": "checkout_list"},
    "project": {"$ref": "../../domain/v1/project.schema.json"},
    "checkouts": {"type": "array", "items": {"$ref": "../../domain/v1/checkout.schema.json"}}
  }
}
