{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:full-doctor-result:v1",
  "title": "Crewfold full doctor result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "status", "event_sequence", "baseline", "resources", "limits", "checks"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:full-doctor-result:v1"},
    "type": {"const": "full_doctor"},
    "status": {"enum": ["ok", "degraded", "failed"]},
    "event_sequence": {"type": "integer", "minimum": 0},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "installed_schema_sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "installed_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_bytes", "referenced_artifact_bytes", "rss_bytes", "goroutines", "open_fds", "filesystem_free_bytes"],
      "properties": {
        "database_bytes": {"type": "integer", "minimum": 0},
        "referenced_artifact_bytes": {"type": "integer", "minimum": 0},
        "rss_bytes": {"type": "integer", "minimum": 0},
        "goroutines": {"type": "integer", "minimum": 0},
        "open_fds": {"type": "integer", "minimum": 0},
        "filesystem_free_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefing_claims", "briefing_bytes", "node_unresolved_runs"],
      "properties": {
        "briefing_claims": {"const": 128},
        "briefing_bytes": {"const": 65536},
        "node_unresolved_runs": {"const": 20}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id", "code", "detail"],
      "properties": {
        "entity_type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_.-]*$"},
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\x00]*$"},
        "code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_.-]*$"},
        "detail": {"type": "string", "maxLength": 2048, "pattern": "^[^\\x00]*$"}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command"],
      "properties": {
        "kind": {"enum": ["none", "retry", "rebuild_knowledge_index", "resolve_lost_runtime", "free_space", "restore_verified_backup", "activate_restore", "report_defect"]},
        "command": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00]*$"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "checked_count", "issue_count", "summary", "samples", "remediation"],
      "properties": {
        "code": {"enum": ["current_baseline", "sqlite_integrity_check", "foreign_keys", "canonical_integrity", "event_contract", "projection_receipt_parity", "artifact_integrity", "derived_knowledge_index", "runtime_bindings", "managed_services", "durable_queues", "filesystem_permissions", "resource_budget", "restore_activation"]},
        "status": {"enum": ["ok", "warning", "failed"]},
        "checked_count": {"type": "integer", "minimum": 0},
        "issue_count": {"type": "integer", "minimum": 0},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\x00]*$"},
        "samples": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/sample"}},
        "remediation": {"$ref": "#/$defs/remediation"}
      }
    }
  }
}
