{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:events-list-result:v1",
  "title": "Crewfold local API events list result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "workspace_id", "high_water", "events", "next_cursor", "has_more", "total"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:events-list-result:v1"},
    "type": {"const": "event_list"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "high_water": {"type": "integer", "minimum": 0},
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "../../domain/v1/event.schema.json"}
    },
    "next_cursor": {"$ref": "operator-page.schema.json#/$defs/nextCursor"},
    "has_more": {"$ref": "operator-page.schema.json#/$defs/hasMore"},
    "total": {"$ref": "operator-page.schema.json#/$defs/total"}
  }
}
