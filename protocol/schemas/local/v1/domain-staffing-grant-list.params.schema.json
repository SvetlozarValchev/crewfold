{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-staffing-grant-list-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "manager_agent"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "manager_agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"}
  }
}
