{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:knowledge-search-params:v1",
  "title": "Crewfold local API deterministic knowledge search parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "query"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "query": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "description": "The store additionally enforces at most 256 UTF-8 bytes and 16 whitespace-separated literal terms."
    },
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "type": {"enum": ["decision", "finding"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
