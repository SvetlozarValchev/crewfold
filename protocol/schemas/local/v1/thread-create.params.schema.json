{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:thread-create-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "subject", "participants", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1, "maxLength": 160},
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "thread-participant-input.schema.json"}
    },
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
