{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:contradiction-list-params:v1",
  "title": "Crewfold local API contradiction list parameters v1",
  "type": "object",
  "additionalProperties": false,
	"required": ["workspace", "project"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
	"status": {"enum": ["proposed", "open", "resolved", "dismissed"], "description": "When omitted, returns only active proposed and open contradictions."},
    "revision": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
	"limit": {"type": "integer", "minimum": 1, "maximum": 200, "description": "Bounded first-slice size; defaults to 50. This version has no continuation cursor."}
  }
}
