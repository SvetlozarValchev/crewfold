{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:task-timeline-params:v1",
  "title": "Crewfold local API task timeline parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "task"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}
  }
}
