{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:claim-release-params:v1",
  "title": "Crewfold local API claim release parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "claim", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "claim": {"type": "string", "pattern": "^claim_[0-9a-f]{32}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
