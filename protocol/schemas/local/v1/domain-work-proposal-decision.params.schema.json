{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-work-proposal-decision-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "proposal_id", "expected_revision", "decision_note", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "proposal_id": {"type": "string", "pattern": "^workprop_[0-9a-f]{32}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "decision_note": {"type": "string", "minLength": 1, "maxLength": 2048},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
