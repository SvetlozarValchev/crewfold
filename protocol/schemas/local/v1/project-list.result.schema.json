{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:project-list-result:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "projects", "next_cursor", "has_more", "total"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:project-list-result:v1"},
    "type": {"const": "project_list"},
    "projects": {"type": "array", "maxItems": 200, "items": {"$ref": "../../domain/v1/project.schema.json"}},
    "next_cursor": {"$ref": "operator-page.schema.json#/$defs/nextCursor"},
    "has_more": {"$ref": "operator-page.schema.json#/$defs/hasMore"},
    "total": {"$ref": "operator-page.schema.json#/$defs/total"}
  }
}
