{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-repair-query-params:v1",
  "type":"object","additionalProperties":false,"required":["workspace"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "repair":{"type":"string","pattern":"^checkrepair_[0-9a-f]{32}$"},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "task":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},
    "status":{"enum":["pending","accepted","rejected","stale"]},
    "limit":{"type":"integer","minimum":1,"maximum":100}
  }
}
