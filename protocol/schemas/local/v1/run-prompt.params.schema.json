{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-prompt-params:v1",
  "title": "Crewfold local API run prompt parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "run", "text"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "run": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 16384}
  }
}
