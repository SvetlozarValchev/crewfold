{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-session-result:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "view"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:domain-agent-session-result:v1"},
    "type": {"const": "domain_agent_session"},
    "view": {"$ref": "#/$defs/view"},
    "accepted_turn": {"$ref": "#/$defs/turn"}
  },
  "$defs": {
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["session", "thread_status", "turns"],
      "properties": {
        "session": {"$ref": "../../domain/v1/domain-agent-session.schema.json"},
        "thread_status": {"enum": ["unbound", "detached", "notLoaded", "idle", "systemError", "active"]},
        "turns": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/turn"}}
      }
    },
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "items"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 65536},
        "status": {"type": "string", "minLength": 1, "maxLength": 65536},
        "items": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 65536},
        "type": {"enum": ["userMessage", "agentMessage", "plan", "commandExecution", "mcpToolCall", "dynamicToolCall", "collabAgentToolCall", "fileChange", "webSearch", "subAgentActivity", "reasoning", "error"]},
        "origin": {"enum": ["owner", "crewfold_delivery"]},
        "text": {"type": "string", "maxLength": 65536},
        "command": {"type": "string", "maxLength": 65536},
        "status": {"type": "string", "maxLength": 65536},
        "cwd": {"type": "string", "maxLength": 65536},
        "process_id": {"type": "string", "maxLength": 65536},
        "exit_code": {"type": "integer"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "command_actions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/command_action"}},
        "changes": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/file_change"}}
      }
    },
    "command_action": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["read", "listFiles", "search", "unknown"]},
        "command": {"type": "string", "maxLength": 65536},
        "name": {"type": "string", "maxLength": 65536},
        "path": {"type": "string", "maxLength": 65536},
        "query": {"type": "string", "maxLength": 65536}
      }
    },
    "file_change": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 65536},
        "kind": {"enum": ["add", "delete", "update"]},
        "diff": {"type": "string", "maxLength": 65536}
      }
    }
  }
}
