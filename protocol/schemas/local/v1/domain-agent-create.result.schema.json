{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-create-result:v1",
  "title": "Crewfold local API domain agent create result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "agent", "event_sequences"],
