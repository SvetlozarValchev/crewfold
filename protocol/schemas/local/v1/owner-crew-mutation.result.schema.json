{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:owner-crew-mutation-result:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "action", "binding", "agent", "worker_profiles", "event_sequence"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:owner-crew-mutation-result:v1"},
    "type": {"const": "owner_crew_mutation"},
    "action": {"enum": ["add", "disable"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "project_id", "objective_id", "planning_task_id", "agent_id", "manager_grant_id", "launch_profile_id", "status", "revision", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^exec_[0-9a-f]{32}$"},
        "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
        "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
        "objective_id": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
        "planning_task_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
        "agent_id": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
        "manager_grant_id": {"type": "string", "pattern": "^mgrgrant_[0-9a-f]{32}$"},
        "launch_profile_id": {"type": "string", "pattern": "^lprof_[0-9a-f]{32}$"},
        "status": {"const": "active"},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "agent": {"$ref": "../../domain/v1/agent.schema.json"},
    "worker_profiles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "../../domain/v1/launch-profile.schema.json"}},
    "event_sequence": {"type": "integer", "minimum": 1}
  }
}
