{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:context-query-params:v1",
  "title": "Crewfold local API context query parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "context"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "context": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"}
  }
}
