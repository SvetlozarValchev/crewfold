{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:agent-mutation-result:v1",
  "title": "Crewfold local API agent mutation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "agent", "event_sequence"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:agent-mutation-result:v1"},
    "type": {"const": "agent_mutation"},
    "agent": {"$ref": "../../domain/v1/agent.schema.json"},
    "event_sequence": {"type": "integer", "minimum": 1}
  }
}
