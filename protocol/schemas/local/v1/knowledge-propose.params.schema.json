{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:knowledge-propose-params:v1",
  "title": "Crewfold local API knowledge proposal parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace", "type", "title", "body", "confidence",
    "verification_status", "freshness_policy", "sources", "idempotency_key"
  ],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_scope_id": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "type": {"enum": ["decision", "finding"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "body": {"type": "string", "minLength": 1, "maxLength": 16384},
    "confidence": {"enum": ["low", "medium", "high"]},
    "verification_status": {"enum": ["unverified", "supported", "verified"]},
    "freshness_policy": {"enum": ["until_superseded", "expires_at"]},
    "fresh_until": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "../../domain/v1/knowledge-source.schema.json#/$defs/sourceInput"},
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": {"role": {"const": "primary"}}
      },
      "minContains": 1,
      "maxContains": 1
    },
    "supersedes_revision_id": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "allOf": [
    {
      "if": {"properties": {"freshness_policy": {"const": "expires_at"}}, "required": ["freshness_policy"]},
      "then": {"required": ["fresh_until"]},
      "else": {"not": {"required": ["fresh_until"]}}
    }
  ]
}
