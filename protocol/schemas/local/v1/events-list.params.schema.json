{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:events-list-params:v1",
  "title": "Crewfold local API events list parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "after"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "after": {"type": "integer", "minimum": 0},
    "cursor": {"$ref": "operator-page.schema.json#/$defs/cursor"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 1000}
  }
}
