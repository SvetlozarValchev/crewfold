{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:thread-list-result:v1",
  "title": "Crewfold local API thread list result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "threads"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:thread-list-result:v1"},
    "type": {"const": "thread_list"},
    "threads": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "../../domain/v1/thread-summary.schema.json"}
    }
  }
}
