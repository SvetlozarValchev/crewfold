{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:backup-create-result:v1",
  "title": "Crewfold backup creation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "backup"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:backup-create-result:v1"},
    "type": {"const": "backup"},
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "created_at", "baseline_sha256", "event_sequence", "logical_state_sha256", "database_sha256", "manifest_sha256", "artifact_count", "total_bytes"],
      "properties": {
        "id": {"type": "string", "pattern": "^backup_[0-9a-f]{32}$"},
        "path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\x00]*$"},
        "created_at": {"type": "string", "format": "date-time"},
        "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_sequence": {"type": "integer", "minimum": 0},
        "logical_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_count": {"type": "integer", "minimum": 0, "maximum": 200000},
        "total_bytes": {"type": "integer", "minimum": 1, "maximum": 17179869184}
      }
    }
  }
}
