{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:curator-queue-params:v1",
  "title": "Crewfold local API curator queue parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "after": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque resumable cursor returned by an earlier curator queue page."
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 200}
  }
}
