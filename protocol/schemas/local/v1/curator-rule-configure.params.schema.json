{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:curator-rule-configure-params:v1",
  "title": "Crewfold local API curator rule configuration parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "rule", "enabled", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "rule": {"const": "accepted_meeting_resolution_copy/v1"},
    "enabled": {"type": "boolean"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
