{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-control-result:v1",
  "title": "Crewfold local API run control result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "run_id", "runtime", "action", "status"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:run-control-result:v1"},
    "type": {"const": "run_control"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 64},
    "action": {"enum": ["prompt", "interrupt"]},
    "status": {"const": "delivered"}
  }
}
