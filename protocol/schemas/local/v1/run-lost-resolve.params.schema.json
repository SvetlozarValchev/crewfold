{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-lost-resolve-params:v1",
  "title": "Crewfold run lost resolution parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "run", "expected_revision", "note", "runtime_retired_confirmed", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "run": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "note": {"type": "string", "minLength": 1, "maxLength": 2048},
    "runtime_retired_confirmed": {"const": true},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
