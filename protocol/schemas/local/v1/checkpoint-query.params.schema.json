{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:checkpoint-query-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "checkpoint": {"type": "string", "pattern": "^outcpnt_[0-9a-f]{32}$"},
    "scope_type": {"enum": ["task", "objective", "project", "workspace"]},
    "scope_identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "dependentRequired": {"scope_type": ["scope_identifier"], "scope_identifier": ["scope_type"]},
  "allOf": [
    {
      "if": {"required": ["scope_type"]},
      "then": {
        "oneOf": [
          {"properties": {"scope_type": {"const": "task"}, "scope_identifier": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}}, "required": ["scope_type", "scope_identifier"]},
          {"properties": {"scope_type": {"const": "objective"}, "scope_identifier": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"}}, "required": ["scope_type", "scope_identifier"]},
          {"properties": {"scope_type": {"const": "project"}}, "required": ["scope_type", "scope_identifier"]},
          {"properties": {"scope_type": {"const": "workspace"}}, "required": ["scope_type", "scope_identifier"]}
        ]
      }
    }
  ]
}
