{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-spec-draft-params:v1",
  "title": "Crewfold local API domain agent specification draft parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner_intent"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "checkout": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "repository_path": {"type": "string", "minLength": 2, "maxLength": 4096},
    "domain_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "owner_intent": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "oneOf": [
    {"required": ["workspace", "project"], "not": {"anyOf": [{"required": ["repository_path"]}, {"required": ["domain_name"]}]}},
    {"required": ["repository_path", "domain_name"], "not": {"anyOf": [{"required": ["workspace"]}, {"required": ["project"]}, {"required": ["checkout"]}]}}
  ]
}
