{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:events-timeline-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "entity_type", "entity_id"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "entity_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "entity_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cursor": {"$ref": "operator-page.schema.json#/$defs/cursor"},
    "limit": {"$ref": "operator-page.schema.json#/$defs/limit"}
  }
}
