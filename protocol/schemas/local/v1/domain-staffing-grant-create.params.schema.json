{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-staffing-grant-create-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "manager_agent", "expected_membership_revision", "profiles", "task_classes", "max_descendants", "max_concurrency", "budget", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "manager_agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "expected_membership_revision": {"type": "integer", "minimum": 1},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "../../domain/v1/domain-agent-staffing-profile.schema.json"}},
    "task_classes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}},
    "max_descendants": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
    "budget": {"$ref": "../../domain/v1/budget.schema.json"},
    "expires_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
