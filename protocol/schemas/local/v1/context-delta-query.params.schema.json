{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:context-delta-query-params:v1",
  "title": "Crewfold local API context delta query parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "delta"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "delta": {"type": "string", "pattern": "^cdelta_[0-9a-f]{32}$"}
  }
}
