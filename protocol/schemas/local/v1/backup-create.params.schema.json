{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:backup-create-params:v1",
  "title": "Crewfold backup creation parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_path", "idempotency_key"],
  "properties": {
    "target_path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\x00]*$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\x00]*$"}
  }
}
