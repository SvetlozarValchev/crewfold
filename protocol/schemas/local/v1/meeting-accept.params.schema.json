{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:meeting-accept-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "meeting", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1},
    "meeting": {"type": "string", "pattern": "^meet_[0-9a-f]{32}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "decision_note": {"type": "string", "maxLength": 4096},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
