{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-update-params:v1",
  "title": "Crewfold local API domain agent update parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "agent", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "parent_agent": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"}]},
    "workstream": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"}]},
    "preferred_entry": {"type": "boolean"},
    "status": {"enum": ["active", "retired"]},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "anyOf": [
    {"required": ["parent_agent"]},
    {"required": ["workstream"]},
    {"required": ["preferred_entry"]},
    {"required": ["status"]}
  ]
}
