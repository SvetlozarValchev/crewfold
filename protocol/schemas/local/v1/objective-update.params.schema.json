{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:objective-update-params:v1",
  "title": "Crewfold local API objective update parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "objective", "expected_revision", "idempotency_key"],
  "anyOf": [{"required": ["title"]}, {"required": ["status"]}, {"required": ["budget"]}],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["active", "completed", "cancelled"]},
    "budget": {"$ref": "../../domain/v1/budget.schema.json"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
