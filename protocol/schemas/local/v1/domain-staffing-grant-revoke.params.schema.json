{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-staffing-grant-revoke-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "grant_id", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "grant_id": {"type": "string", "pattern": "^staffgrant_[0-9a-f]{32}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
