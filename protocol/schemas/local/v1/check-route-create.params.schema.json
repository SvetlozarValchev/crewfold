{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-route-create-params:v1",
  "type":"object","additionalProperties":false,
  "required":["workspace","project","trigger","duty","agent","expected_agent_revision","idempotency_key"],
  "dependentRequired":{"definition":["definition_content_revision"],"definition_content_revision":["definition"]},
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "definition":{"type":"string","minLength":1,"maxLength":128},
    "definition_content_revision":{"type":"integer","minimum":1},
    "trigger":{"enum":["pass","nonpass","stale"]},
    "duty":{"enum":["evidence_review","coordination"]},
    "agent":{"type":"string","minLength":1,"maxLength":128},
    "expected_agent_revision":{"type":"integer","minimum":1},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":128}
  }
}
