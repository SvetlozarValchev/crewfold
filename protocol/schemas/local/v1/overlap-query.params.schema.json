{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:overlap-query-params:v1",
  "title": "Crewfold local API overlap query parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "overlap": {"type": "string", "pattern": "^overlap_[0-9a-f]{32}$"},
    "status": {"enum": ["open", "resolved"]}
  }
}
