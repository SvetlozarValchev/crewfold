{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-definition-create-params:v1",
  "type":"object","additionalProperties":false,
  "required":["workspace","project","name","executable","arguments","working_directory","timeout_millis","output_byte_limit","idempotency_key"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "name":{"type":"string","minLength":1,"maxLength":128},
    "executable":{"type":"string","minLength":1,"maxLength":4096},
    "arguments":{"type":"array","maxItems":64,"items":{"type":"string","maxLength":4096,"pattern":"^[^\\x00]*$"}},
    "working_directory":{"type":"string","maxLength":4096},
    "timeout_millis":{"type":"integer","minimum":100,"maximum":3600000},
    "output_byte_limit":{"type":"integer","minimum":1024,"maximum":1048576},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":128}
  }
}
