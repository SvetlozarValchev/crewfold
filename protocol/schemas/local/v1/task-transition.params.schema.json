{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:task-transition-params:v1",
  "title": "Crewfold local API task transition parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "task", "action", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "action": {"enum": ["start", "block", "unblock", "cancel"]},
    "reason": {"type": "string", "maxLength": 1024},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
