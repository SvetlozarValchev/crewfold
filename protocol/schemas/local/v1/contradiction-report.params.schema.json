{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:contradiction-report-params:v1",
  "title": "Crewfold local API contradiction report parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "left_revision", "right_revision", "reason", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "left_revision": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
    "right_revision": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"},
	"reason": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "Required UTF-8 text; the implementation enforces the 2048 limit on encoded bytes."},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
