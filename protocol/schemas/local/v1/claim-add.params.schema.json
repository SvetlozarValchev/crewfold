{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:claim-add-params:v1",
  "title": "Crewfold local API claim add parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "task", "kind", "target", "lease_seconds", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "checkout": {"type": "string", "minLength": 1},
    "kind": {"enum": ["path", "component", "operation"]},
    "target": {"type": "string", "minLength": 1, "maxLength": 512},
    "mode": {"enum": ["exclusive", "shared", "advisory"]},
    "conflict_policy": {"enum": ["notify", "deny_new", "pause_scheduling", "request_resolution"]},
    "lease_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
