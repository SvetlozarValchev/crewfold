{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:thread-invite-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "thread", "participant", "expected_participant_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1},
    "thread": {"type": "string", "pattern": "^thread_[0-9a-f]{32}$"},
    "participant": {"$ref": "thread-participant-input.schema.json"},
    "expected_participant_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
