{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-attach-params:v1",
  "title": "Crewfold local API domain agent attach parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "agent", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "parent_agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "workstream": {"type": "string", "pattern": "^obj_[0-9a-f]{32}$"},
    "preferred_entry": {"type": "boolean"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
