{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:context-refresh-result:v1",
  "title": "Crewfold local API context refresh result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "status", "run_id", "context_packet_id", "state_revision", "scanned_from_event_sequence", "scanned_through_event_sequence", "chain", "event_sequence"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:context-refresh-result:v1"},
    "type": {"const": "context_refresh"},
    "status": {"enum": ["created", "pending", "up_to_date", "rebase_required"]},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "context_packet_id": {"type": "string", "pattern": "^ctx_[0-9a-f]{32}$"},
    "state_revision": {"type": "integer", "minimum": 0},
    "scanned_from_event_sequence": {"type": "integer", "minimum": 0},
    "scanned_through_event_sequence": {"type": "integer", "minimum": 0},
    "chain": {"$ref": "../../domain/v1/context-delta-chain.schema.json"},
    "delta": {"$ref": "../../domain/v1/context-delta.schema.json"},
    "rebase_reason": {"enum": ["unsupported_packet", "base_contract_changed", "dependency_set_changed", "event_window_exceeded", "delta_limit_exceeded", "cumulative_limit_exceeded", "unsupported_event_type"]},
    "event_sequence": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "created"}}}, "then": {"$ref": "../../domain/v1/context-refresh-result.schema.json#/$defs/pending_chain", "required": ["delta"], "not": {"required": ["rebase_reason"]}, "properties": {"event_sequence": {"minimum": 1}}}},
    {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"$ref": "../../domain/v1/context-refresh-result.schema.json#/$defs/pending_chain", "required": ["delta"], "not": {"required": ["rebase_reason"]}, "properties": {"event_sequence": {"const": 0}}}},
    {
      "if": {"properties": {"status": {"const": "rebase_required"}}},
      "then": {
        "$ref": "../../domain/v1/context-refresh-result.schema.json#/$defs/rebase_union",
        "required": ["rebase_reason"],
        "not": {"required": ["delta"]}
      }
    },
    {"if": {"properties": {"status": {"const": "up_to_date"}}}, "then": {"$ref": "../../domain/v1/context-refresh-result.schema.json#/$defs/clear_chain", "not": {"anyOf": [{"required": ["delta"]}, {"required": ["rebase_reason"]}]}, "properties": {"event_sequence": {"const": 0}}}}
  ]
}
