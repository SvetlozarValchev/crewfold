{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:task-dependency-params:v1",
  "title": "Crewfold local API task dependency parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "task", "depends_on", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "depends_on": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "delivery_requirement": {"enum": ["completion", "handoff", "handoff_with_evidence"]},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
