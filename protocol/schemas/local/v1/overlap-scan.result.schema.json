{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:overlap-scan-result:v1",
  "title": "Crewfold local API overlap scan result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "scans", "issues"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:overlap-scan-result:v1"},
    "type": {"const": "overlap_scan"},
    "scans": {"type": "array", "items": {"$ref": "../../domain/v1/checkout-claim-scan.schema.json"}},
    "issues": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
