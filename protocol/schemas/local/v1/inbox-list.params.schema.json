{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:inbox-list-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "agent"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50}
  }
}
