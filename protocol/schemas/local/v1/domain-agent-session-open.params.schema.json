{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-session-open-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "agent", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "checkout": {"type": "string", "pattern": "^co_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
