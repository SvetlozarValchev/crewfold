{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:knowledge-mutation-result:v1",
  "title": "Crewfold local API knowledge mutation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "revision", "event_sequence"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:knowledge-mutation-result:v1"},
    "type": {"const": "knowledge_mutation"},
    "revision": {"$ref": "../../domain/v1/knowledge-revision.schema.json"},
    "authority_check": {"$ref": "../../domain/v1/knowledge-authority.schema.json"},
    "event_sequence": {"type": "integer", "minimum": 1}
  }
}
