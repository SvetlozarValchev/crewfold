{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:context-delta-list-result:v1",
  "title": "Crewfold local API context delta list result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "chain", "after_sequence", "next_sequence", "has_more", "deltas"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:context-delta-list-result:v1"},
    "type": {"const": "context_delta_list"},
    "chain": {"$ref": "../../domain/v1/context-delta-chain.schema.json"},
    "after_sequence": {"type": "integer", "minimum": 0},
    "next_sequence": {"type": "integer", "minimum": 0},
    "has_more": {"type": "boolean"},
    "deltas": {"type": "array", "maxItems": 100, "items": {"$ref": "../../domain/v1/context-delta.schema.json"}}
  }
}
