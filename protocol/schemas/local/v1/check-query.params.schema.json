{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-query-params:v1",
  "type":"object","additionalProperties":false,"required":["workspace"],
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "check_run":{"type":"string","pattern":"^checkrun_[0-9a-f]{32}$"},
    "project":{"type":"string","minLength":1,"maxLength":128},
    "task":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},
    "requirement":{"type":"string","pattern":"^checkreq_[0-9a-f]{32}$"},
    "definition":{"type":"string","pattern":"^checkdef_[0-9a-f]{32}$"},
    "status":{"enum":["requested","starting","running","finished"]},
    "outcome":{"enum":["passed","failed","timed_out","start_failed","unknown"]},
    "limit":{"type":"integer","minimum":1,"maximum":100}
  }
}
