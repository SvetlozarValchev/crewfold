{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-artifact-show-params:v1",
  "title": "Crewfold local API run artifact show parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "artifact"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"}
  }
}
