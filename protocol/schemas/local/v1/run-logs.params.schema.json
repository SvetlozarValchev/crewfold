{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-logs-params:v1",
  "title": "Crewfold local API run logs parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "run", "tail"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "run": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "tail": {"type": "integer", "minimum": 0, "maximum": 10000}
  }
}
