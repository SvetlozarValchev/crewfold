{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-tree-result:v1",
  "title": "Crewfold local API domain agent tree result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "project_id", "agents"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:domain-agent-tree-result:v1"},
    "type": {"const": "domain_agent_tree"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "agents": {"type": "array", "maxItems": 1000, "items": {"$ref": "../../domain/v1/domain-agent.schema.json"}}
  }
}
