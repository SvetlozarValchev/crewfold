{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:knowledge-show-params:v1",
  "title": "Crewfold local API knowledge show parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "knowledge_revision"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "knowledge_revision": {"type": "string", "pattern": "^krev_[0-9a-f]{32}$"}
  }
}
