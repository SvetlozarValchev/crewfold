{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:run-loss-resolution-result:v1",
  "title": "Crewfold run loss resolution result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "detail", "resolution", "event_sequence"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:run-loss-resolution-result:v1"},
    "type": {"const": "run_loss_resolution"},
    "detail": {"$ref": "../../domain/v1/run-detail.schema.json"},
    "resolution": {"$ref": "../../domain/v1/run-loss-resolution.schema.json"},
    "event_sequence": {"type": "integer", "minimum": 1}
  }
}
