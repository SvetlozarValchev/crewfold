{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:task-query-params:v1",
  "title": "Crewfold local API task query parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "ready_only": {"type": "boolean"}
  }
}
