{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:domain-agent-spec-draft-result:v1",
  "title": "Crewfold local API domain agent specification draft result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "draft"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:domain-agent-spec-draft-result:v1"},
    "type": {"const": "domain_agent_spec_draft"},
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "operating_charter", "delegation_policy", "rationale"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "operating_charter": {"type": "string", "minLength": 1, "maxLength": 8192},
        "delegation_policy": {"enum": ["hands_on", "adaptive", "delegation_first"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  }
}
