{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:knowledge-import-params:v1",
  "title": "Crewfold portable knowledge import parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "directory", "expected_content_sha256", "create_scope", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "directory": {
      "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/",
      "description": "An absolute clean non-root Linux path. The daemon additionally enforces the 4096 bound on UTF-8 bytes; bundle bytes stay daemon-local and are not carried in the bounded JSON request."
    },
    "expected_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "create_scope": {"type": "boolean"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
