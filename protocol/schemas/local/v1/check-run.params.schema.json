{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:crewfold:schema:local-api:check-run-params:v1",
  "type":"object","additionalProperties":false,
  "required":["workspace","task","definition","idempotency_key"],
  "dependentRequired":{"expected_checkout_revision":["checkout"]},
  "properties":{
    "workspace":{"type":"string","minLength":1,"maxLength":128},
    "task":{"type":"string","pattern":"^task_[0-9a-f]{32}$"},
    "definition":{"type":"string","minLength":1,"maxLength":128},
    "checkout":{"type":"string","pattern":"^co_[0-9a-f]{32}$"},
    "expected_requirement_revision":{"type":"integer","minimum":1},
    "expected_definition_content_revision":{"type":"integer","minimum":1},
    "expected_checkout_revision":{"type":"integer","minimum":1},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":128}
  }
}
