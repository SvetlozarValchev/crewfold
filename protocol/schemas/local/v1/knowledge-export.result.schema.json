{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:knowledge-export-result:v1",
  "title": "Crewfold portable knowledge export result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "directory", "bundle_id", "content_sha256", "manifest_sha256", "manifest_bytes", "markdown_sha256", "markdown_bytes", "as_of_event_sequence", "counts"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:knowledge-export-result:v1"},
    "type": {"const": "knowledge_export"},
    "directory": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/"},
    "bundle_id": {"type": "string", "pattern": "^kbun_[0-9a-f]{32}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "markdown_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "as_of_event_sequence": {"type": "integer", "minimum": 0},
    "counts": {"$ref": "../../portable/v1/knowledge-bundle-manifest.schema.json#/$defs/counts"}
  }
}
