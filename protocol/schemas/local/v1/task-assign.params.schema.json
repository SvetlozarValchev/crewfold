{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:task-assign-params:v1",
  "title": "Crewfold local API task assignment parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "task", "agent", "lease_seconds", "expected_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "agent": {"type": "string", "minLength": 1, "maxLength": 128},
    "lease_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
