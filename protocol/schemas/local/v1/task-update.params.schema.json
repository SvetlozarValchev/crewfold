{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:task-update-params:v1",
  "title": "Crewfold local API task update parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "task", "expected_revision", "idempotency_key"],
  "anyOf": [{"required": ["title"]}, {"required": ["description"]}, {"required": ["priority"]}, {"required": ["budget"]}],
  "properties": {
    "workspace": {"type": "string", "minLength": 1, "maxLength": 128},
    "task": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 4096},
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "budget": {"$ref": "../../domain/v1/budget.schema.json"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
