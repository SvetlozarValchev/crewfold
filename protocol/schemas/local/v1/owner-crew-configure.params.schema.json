{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:owner-crew-configure-params:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "project", "action", "expected_binding_revision", "idempotency_key"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^ws_[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "action": {"enum": ["add", "disable"]},
    "expected_binding_revision": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "agent": {"type": "string", "pattern": "^agent_[0-9a-f]{32}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "add"}}},
      "then": {"required": ["name", "provider", "runtime", "max_concurrency"], "not": {"required": ["agent"]}}
    },
    {
      "if": {"properties": {"action": {"const": "disable"}}},
      "then": {"required": ["agent"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["provider"]}, {"required": ["runtime"]}, {"required": ["max_concurrency"]}]}}
    }
  ]
}
