{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crewfold:schema:local-api:workspace-init-result:v1",
  "title": "Crewfold local API workspace init result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "workspace", "event_id", "event_sequence"],
  "properties": {
    "schema": {"const": "urn:crewfold:schema:local-api:workspace-init-result:v1"},
    "type": {"const": "workspace_initialized"},
    "workspace": {"$ref": "../../domain/v1/workspace.schema.json"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{32}$"},
    "event_sequence": {"type": "integer", "minimum": 1}
  }
}
